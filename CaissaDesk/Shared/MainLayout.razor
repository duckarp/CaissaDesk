@inherits LayoutComponentBase
@using CaissaDesk.Localization
@inject ILocalizationService Loc

@* Catches rendering and event-handler exceptions anywhere below; the WebView error boundary logger writes them to the log file *@
<ErrorBoundary @ref="_errorBoundary">
	<ChildContent>
		@Body
	</ChildContent>
	<ErrorContent Context="exception">
		<div class="panel-card" role="alert" style="max-width: 560px; margin: 60px auto; padding: 32px 28px; text-align: center;">
			<div style="color: var(--accent-danger); margin-bottom: 12px;"><AppIcon Name="warning" Size="32" /></div>
			<div style="font-weight: 700; font-size: 16px; color: var(--text-primary); margin-bottom: 8px;">@Loc["Error_UnexpectedTitle"]</div>
			<div style="color: var(--text-secondary); font-size: 13px; line-height: 1.5; margin-bottom: 12px;">@Loc["Error_UnexpectedDesc"]</div>
			<pre style="text-align: left; white-space: pre-wrap; word-break: break-word; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 8px 10px; margin: 0 0 18px 0; max-height: 160px; overflow: auto;">@exception.Message</pre>
			<button type="button" class="btn-primary" @onclick="Recover">
				<AppIcon Name="refresh" Size="14" />
				<span>@Loc["Error_Recover"]</span>
			</button>
		</div>
	</ErrorContent>
</ErrorBoundary>

<ToastHost />

@code {
	private ErrorBoundary? _errorBoundary;

	private void Recover() => _errorBoundary?.Recover();
}
