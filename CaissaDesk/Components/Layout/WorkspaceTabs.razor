@namespace CaissaDesk.Components.Layout
@using CaissaDesk.Components
@using CaissaDesk.Components.Icons
@using CaissaDesk.Components.Dashboard
@using Caissa.Shared.Models
@using CaissaDesk.Localization
@inject WorkspaceState Workspace
@inject ILocalizationService Loc
@implements IDisposable

<header class="app-header">
	<button type="button" class="app-brand" @onclick="Workspace.SelectDashboard" title="@Loc["App_Title"]" aria-label="@Loc["App_BrandLabel", AppVersion]">
		<img src="images/icon.svg" alt="" class="brand-logo-icon" />
		<span class="brand-title" aria-hidden="true">
			<strong class="brand-caissa">CAISSA</strong><span class="brand-desk">DESK</span>
		</span>
		<span class="brand-badge" title="@Loc["App_VersionTooltip"]" aria-hidden="true">
			<span>v@(AppVersion)</span>
		</span>
	</button>

	<div class="header-actions">
		<button type="button" class="btn-secondary" title="@Loc["Nav_Settings"]" @onclick="() => Workspace.CreateSettingsTab()">
			<AppIcon Name="settings" Size="14" />
			<span>@Loc["Nav_Settings"]</span>
		</button>
		<button type="button" class="btn-primary" @onclick="OpenCreateTournamentModal">
			<AppIcon Name="plus" Size="14" />
			<span>@Loc["Nav_NewTournament"]</span>
		</button>
	</div>
</header>

<nav class="workspace-tabs-container" aria-label="@Loc["Nav_OpenTabs"]">
	<div class="tab-list">
		@foreach (var tab in Workspace.Tabs)
		{
			bool isActive = tab == Workspace.ActiveTab;
			string tabClass = isActive ? "workspace-tab workspace-tab-group tab-active" : "workspace-tab workspace-tab-group";
			string tabTitle = tab is DashboardTab ? Loc["Nav_Dashboard"] : tab is SettingsTab ? Loc["Nav_Settings"] : tab.Title;

			@* Two sibling buttons (select, close) inside the tab pill: interactive content must not be nested *@
			<div @key="tab.Id" class="@tabClass">
				<button type="button" class="workspace-tab-select" aria-current="@(isActive ? "page" : null)" @onclick="() => Workspace.SelectTab(tab.Id)">
					<span class="tab-icon">
						<AppIcon Name="@tab.Icon" Size="14" />
					</span>
					<span>@tabTitle</span>
				</button>
				@if (tab.CanClose)
				{
					<button type="button" class="tab-close-btn" @onclick="() => Workspace.CloseTab(tab.Id)" title="@Loc["Nav_CloseTab"]" aria-label="@Loc["Nav_CloseTabLabel", tabTitle]">
						<AppIcon Name="x" Size="10" />
					</button>
				}
			</div>
		}
		<button class="new-tab-btn" title="@Loc["Nav_NewTournament"]" aria-label="@Loc["Nav_NewTournament"]" @onclick="OpenCreateTournamentModal" type="button">
			<AppIcon Name="plus" Size="13" />
		</button>
	</div>
</nav>

<CreateTournamentModal IsOpen="_showCreateModal"
					   OnClose="() => _showCreateModal = false"
					   OnCreated="HandleTournamentCreated" />

@code {
	private bool _showCreateModal = false;

	// Product version from the assembly informational version (set via <Version> in
	// Directory.Build.props or -p:Version=... in the release workflow), without the "+commit" suffix.
	private static readonly string AppVersion = GetAppVersion();

	private static string GetAppVersion()
	{
		var assembly = typeof(WorkspaceTabs).Assembly;
		var informational = System.Reflection.CustomAttributeExtensions
			.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(assembly)?.InformationalVersion;
		if (!string.IsNullOrWhiteSpace(informational))
		{
			var plus = informational.IndexOf('+');
			return plus >= 0 ? informational[..plus] : informational;
		}
		return assembly.GetName().Version?.ToString(3) ?? "0.0.0";
	}

	protected override void OnInitialized()
	{
		Workspace.OnChange += StateHasChanged;
		Workspace.OnRequestCreateTournament += HandleRequestCreateTournament;
		Loc.OnLanguageChanged += StateHasChanged;
	}

	private void OpenCreateTournamentModal()
	{
		_showCreateModal = true;
	}

	private void HandleRequestCreateTournament()
	{
		_showCreateModal = true;
		StateHasChanged();
	}

	private void HandleTournamentCreated(Tournament tournament)
	{
		_showCreateModal = false;
		Workspace.OpenTournament(tournament);
	}

	public void Dispose()
	{
		Workspace.OnChange -= StateHasChanged;
		Workspace.OnRequestCreateTournament -= HandleRequestCreateTournament;
		Loc.OnLanguageChanged -= StateHasChanged;
	}
}
