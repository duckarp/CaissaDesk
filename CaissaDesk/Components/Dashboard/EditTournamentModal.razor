@namespace CaissaDesk.Components.Dashboard
@using Caissa.Shared.Models
@using CaissaDesk.Data
@using CaissaDesk.Localization
@inject ITournamentRepository TournamentRepo
@inject ILocalizationService Loc
@implements IDisposable

@if (IsOpen)
{
	<ModalDialog LabelledBy="@_titleId" OnCancel="CloseAsync" Style="max-width: 620px;">
		<div class="modal-header">
			<div class="modal-title" id="@_titleId">
				<span style="color: var(--brand-gold);"><AppIcon Name="edit" Size="18" /></span>
				<span>@Loc["Tournament_EditTitle"]</span>
			</div>
			<button class="modal-close-btn" @onclick="CloseAsync" type="button" title="@Loc["Common_Close"]" aria-label="@Loc["Common_Close"]">
				<AppIcon Name="x" Size="15" />
			</button>
		</div>

		<div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
			@if (_loading)
			{
				<div style="text-align: center; padding: 32px 16px; color: var(--text-secondary);">
					@Loc["Workbench_Loading"]
				</div>
			}
			else if (_tournament == null)
			{
				<div style="text-align: center; padding: 24px; color: var(--accent-danger);">
					@Loc["Workbench_NotFoundDesc"]
				</div>
			}
			else
			{
				@if (!string.IsNullOrEmpty(_errorMessage))
				{
					<div role="alert" style="background-color: rgba(218, 54, 51, 0.12);
 border: 1px solid var(--accent-danger); border-radius: 6px; padding: 10px 14px; margin-bottom: 12px; color: var(--accent-danger); font-size: 13px; display: flex; align-items: center; gap: 8px;">
						<AppIcon Name="alert" Size="16" />
						<span>@_errorMessage</span>
					</div>
				}

				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-f1")">@Loc["Tournament_Name"]</label>
					<input id="@($"{_titleId}-f1")" type="text" class="form-input" @bind="_name" placeholder="@Loc["Tournament_PlaceholderName"]" autofocus />
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f2")">@Loc["Tournament_TotalRounds"]</label>
						<input id="@($"{_titleId}-f2")" type="number"
							   class="form-input"
							   style="@(_totalRounds < _minAllowedRounds ? "border-color: var(--accent-danger);" : "")"
							   @bind="_totalRounds"
							   min="@_minAllowedRounds"
							   max="50" />
						<div style="font-size: 11px; color: @(_totalRounds < _minAllowedRounds ? "var(--accent-danger)" : "var(--text-secondary)"); margin-top: 4px;">
							@Loc["Tournament_MinRoundsNotice", _minAllowedRounds, _finishedRoundsCount]
						</div>
					</div>

					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f3")">@Loc["Tournament_Venue"]</label>
						<input id="@($"{_titleId}-f3")" type="text" class="form-input" @bind="_venue" placeholder="@Loc["Settings_PlaceholderVenue"]" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f4")">@Loc["Tournament_ChiefArbiter"]</label>
						<input id="@($"{_titleId}-f4")" type="text" class="form-input" @bind="_chiefArbiter" placeholder="@Loc["Settings_PlaceholderChiefArbiter"]" />
					</div>

					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f5")">@Loc["Tournament_DeputyArbiter"]</label>
						<input id="@($"{_titleId}-f5")" type="text" class="form-input" @bind="_deputyArbiter" placeholder="@Loc["Settings_PlaceholderDeputyArbiter"]" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f6")">@Loc["Tournament_Organizer"]</label>
						<input id="@($"{_titleId}-f6")" type="text" class="form-input" @bind="_organizer" placeholder="@Loc["Settings_PlaceholderOrganizer"]" />
					</div>

					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f7")">@Loc["Tournament_Federation"]</label>
						<input id="@($"{_titleId}-f7")" type="text" class="form-input" @bind="_federation" placeholder="@Loc["Settings_PlaceholderFederation"]"
 maxlength="3" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f8")">@Loc["Tournament_TimeControl"]</label>
						<select id="@($"{_titleId}-f8")" class="form-select" @bind="_timeControl">
							<option value="@TimeControlCategory.Rapid">@Loc["TimeControl_Rapid"]</option>
							<option value="@TimeControlCategory.Blitz">@Loc["TimeControl_Blitz"]</option>
							<option value="@TimeControlCategory.Standard">@Loc["TimeControl_Standard"]</option>
						</select>
					</div>

					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f9")">@Loc["Tournament_TimeControlSpec"]</label>
						<input id="@($"{_titleId}-f9")" type="text" class="form-input" @bind="_timeControlSpec" placeholder="@Loc["Settings_PlaceholderTimeControl"]" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f10")">@Loc["Tournament_StartDate"]</label>
						<input id="@($"{_titleId}-f10")" type="date" class="form-input" value="@_startDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateInput" />
					</div>

					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f11")">@Loc["Tournament_EndDate"]</label>
						<input id="@($"{_titleId}-f11")" type="date" class="form-input" value="@_endDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateInput" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-f12")">@Loc["Tournament_SeedingPrecedence"]</label>
						<select id="@($"{_titleId}-f12")" class="form-select" @bind="_seeding">
							<option value="@SeedingPrecedence.FideFirst">@Loc["Tournament_FideFirst"]</option>
							<option value="@SeedingPrecedence.NationalFirst">@Loc["Tournament_NationalFirst"]</option>
						</select>
					</div>

					<div class="form-group" style="display: flex; align-items: flex-end; padding-bottom: 8px;">
						<div style="display: flex; align-items: center; gap: 8px;">
							<input type="checkbox" id="@($"{_titleId}-fide-rated")" @bind="_fideRated" style="cursor: pointer; width: 16px; height: 16px; accent-color: var(--brand-gold);" />
							<label for="@($"{_titleId}-fide-rated")" style="font-size: 13px; color: var(--text-primary); cursor: pointer; user-select: none;">
								@Loc["Tournament_FideRated"]
							</label>
						</div>
					</div>
				</div>

				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-f13")">@Loc["Tournament_TopSeedColor"]</label>
					<select id="@($"{_titleId}-f13")" class="form-select" @bind="_topSeedColor" disabled="@_topSeedColorLocked">
						<option value="@FirstRoundColor.White">@Loc["Common_White"]</option>
						<option value="@FirstRoundColor.Black">@Loc["Common_Black"]</option>
					</select>
					<div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
						@(_topSeedColorLocked ? Loc["Tournament_TopSeedColorLocked"] : Loc["Tournament_TopSeedColorHint"])
					</div>
				</div>
			}
		</div>

		<div class="modal-footer">
			<button class="btn-secondary" @onclick="CloseAsync">@Loc["Common_Cancel"]</button>
			<button class="btn-primary" @onclick="SaveAsync" disabled="@(_loading || _tournament == null || string.IsNullOrWhiteSpace(_name))">
				<AppIcon Name="save" Size="14" />
				<span>@Loc["Common_SaveChanges"]</span>
			</button>
		</div>
	</ModalDialog>
}

@code {
	private readonly string _titleId = DomIds.Next("edit-tournament-title");
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public Tournament? Tournament { get; set; }
	[Parameter] public string? TournamentId { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public EventCallback<Tournament> OnSaved { get; set; }

	private Tournament? _tournament;
	private bool _loading;
	private string? _errorMessage;
	private bool _wasOpen;
	private string? _loadedTournamentId;

	private string _name = string.Empty;
	private int _totalRounds = 7;
	private int _minAllowedRounds = 1;
	private int _finishedRoundsCount = 0;
	private string _venue = string.Empty;
	private string _chiefArbiter = string.Empty;
	private string _deputyArbiter = string.Empty;
	private string _organizer = string.Empty;
	private string _federation = "SVK";
	private TimeControlCategory _timeControl = TimeControlCategory.Rapid;
	private string _timeControlSpec = "15m + 5s";
	private DateTime _startDate = DateTime.Today;
	private DateTime _endDate = DateTime.Today;
	private SeedingPrecedence _seeding = SeedingPrecedence.FideFirst;
	private bool _fideRated = true;
	private FirstRoundColor _topSeedColor = FirstRoundColor.White;
	private bool _topSeedColorLocked;

	protected override async Task OnParametersSetAsync()
	{
		if (IsOpen)
		{
			if (Tournament != null && (_tournament != Tournament || !_wasOpen))
			{
				_tournament = Tournament;
				_loadedTournamentId = Tournament.Id;
				PopulateFromTournament(Tournament);
				_loading = false;
				_errorMessage = null;
			}
			else if (Tournament == null && !string.IsNullOrEmpty(TournamentId) && (!_wasOpen || TournamentId != _loadedTournamentId))
			{
				_loadedTournamentId = TournamentId;
				await LoadTournamentAsync(TournamentId);
			}
		}
		else
		{
			if (_wasOpen)
			{
				_tournament = null;
				_loadedTournamentId = null;
				_errorMessage = null;
				_loading = false;
			}
		}

		_wasOpen = IsOpen;
	}

	protected override void OnInitialized()
	{
		Loc.OnLanguageChanged += StateHasChanged;
	}

	public void Dispose()
	{
		Loc.OnLanguageChanged -= StateHasChanged;
	}

	private void PopulateFromTournament(Tournament t)
	{
		_name = t.Name;
		_totalRounds = t.TotalRounds;
		_minAllowedRounds = t.MinAllowedRounds;
		_finishedRoundsCount = t.FinishedRoundsCount;
		_venue = t.Venue ?? string.Empty;
		_chiefArbiter = t.ChiefArbiter ?? string.Empty;
		_deputyArbiter = t.DeputyArbiter ?? string.Empty;
		_organizer = t.Organizer ?? string.Empty;
		_federation = t.Federation ?? "SVK";
		_timeControl = t.TimeControl;
		_timeControlSpec = t.TimeControlDetails ?? string.Empty;
		_startDate = t.StartDate;
		_endDate = t.EndDate;
		_seeding = t.SeedingPrecedence;
		_fideRated = t.FideRated;
		_topSeedColor = t.TopSeedFirstRoundColor;
		// The initial colour also drives later colour allocation, so it is fixed once round 1 is paired
		_topSeedColorLocked = t.Rounds.Any(r => r.Pairings.Count > 0);
	}

	private async Task LoadTournamentAsync(string id)
	{
		_loading = true;
		_errorMessage = null;

		try
		{
			_tournament = await TournamentRepo.GetByIdAsync(id);
			if (_tournament != null)
			{
				PopulateFromTournament(_tournament);
			}
			else
			{
				_errorMessage = Loc["Workbench_NotFoundDesc"];
			}
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
		finally
		{
			_loading = false;
		}
	}

	private void OnStartDateInput(ChangeEventArgs e)
	{
		if (DateTime.TryParse(e.Value?.ToString(), out var dt))
		{
			_startDate = dt;
		}
	}

	private void OnEndDateInput(ChangeEventArgs e)
	{
		if (DateTime.TryParse(e.Value?.ToString(), out var dt))
		{
			_endDate = dt;
		}
	}

	private async Task CloseAsync()
	{
		_tournament = null;
		_loadedTournamentId = null;
		_errorMessage = null;
		_loading = false;
		await OnClose.InvokeAsync();
	}

	private async Task SaveAsync()
	{
		if (_tournament == null || string.IsNullOrWhiteSpace(_name)) return;
		_errorMessage = null;

		if (!_tournament.TrySetTotalRounds(_totalRounds, out var err))
		{
			_errorMessage = Loc["Tournament_MinRoundsError", _tournament.MinAllowedRounds];
			return;
		}

		_tournament.Name = _name.Trim();
		_tournament.Venue = string.IsNullOrWhiteSpace(_venue) ? null : _venue.Trim();
		_tournament.ChiefArbiter = string.IsNullOrWhiteSpace(_chiefArbiter) ? null : _chiefArbiter.Trim();
		_tournament.DeputyArbiter = string.IsNullOrWhiteSpace(_deputyArbiter) ? null : _deputyArbiter.Trim();
		_tournament.Organizer = string.IsNullOrWhiteSpace(_organizer) ? null : _organizer.Trim();
		_tournament.Federation = string.IsNullOrWhiteSpace(_federation) ? "SVK" : _federation.Trim().ToUpperInvariant();
		_tournament.TimeControl = _timeControl;
		_tournament.TimeControlDetails = _timeControlSpec.Trim();
		_tournament.StartDate = _startDate;
		_tournament.EndDate = _endDate;
		_tournament.SeedingPrecedence = _seeding;
		_tournament.FideRated = _fideRated;
		if (!_topSeedColorLocked) _tournament.TopSeedFirstRoundColor = _topSeedColor;

		await TournamentRepo.SaveAsync(_tournament);
		await OnSaved.InvokeAsync(_tournament);
		await CloseAsync();
	}
}
