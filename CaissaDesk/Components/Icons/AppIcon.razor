@namespace CaissaDesk.Components.Icons
@using System.Collections.Concurrent
@inject ILogger<AppIcon> Logger

@* Decorative by default (hidden from assistive technology); pass Title for an icon that carries meaning on its own *@
<svg class="app-svg-icon @Class"
	 width="@Size"
	 height="@Size"
	 viewBox="0 0 24 24"
	 fill="none"
	 stroke="currentColor"
	 stroke-width="@StrokeWidth"
	 stroke-linecap="round"
	 stroke-linejoin="round"
	 focusable="false"
	 role="@(string.IsNullOrEmpty(Title) ? null : "img")"
	 aria-label="@(string.IsNullOrEmpty(Title) ? null : Title)"
	 aria-hidden="@(string.IsNullOrEmpty(Title) ? "true" : null)">
	@if (!string.IsNullOrEmpty(Title))
	{
		<title>@Title</title>
	}
	@switch (Name.ToLowerInvariant())
	{
		case "dashboard":
			<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
			<polyline points="9 22 9 12 15 12 15 22" />
			break;

		case "globe":
			<circle cx="12" cy="12" r="10" />
			<line x1="2" y1="12" x2="22" y2="12" />
			<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
			break;

		case "cloud":
			<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
			<polyline points="16 16 12 12 8 16" />
			<line x1="12" y1="12" x2="12" y2="21" />
			break;

		case "search":
			<circle cx="11" cy="11" r="8" />
			<line x1="21" y1="21" x2="16.65" y2="16.65" />
			<circle cx="11" cy="11" r="3" />
			<line x1="11" y1="5" x2="11" y2="7" />
			<line x1="11" y1="15" x2="11" y2="17" />
			<line x1="5" y1="11" x2="7" y2="11" />
			<line x1="15" y1="11" x2="17" y2="11" />
			break;

		case "trophy":
			<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
			<path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
			<path d="M4 22h16" />
			<path d="M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1c0 .55.45 1 1 1h8c.55 0 1-.45 1-1v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34" />
			<path d="M18 2H6v7a6 6 0 0 0 12 0V2z" />
			break;

		case "checklist":
			<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
			<rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
			<path d="M9 14l2 2 4-4" />
			break;

		case "settings":
			<circle cx="12" cy="12" r="3" />
			<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
			break;

		case "user":
			<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
			<circle cx="12" cy="7" r="4" />
			break;

		case "cpu":
			<rect x="4" y="4" width="16" height="16" rx="2" />
			<rect x="9" y="9" width="6" height="6" />
			<line x1="9" y1="1" x2="9" y2="4" />
			<line x1="15" y1="1" x2="15" y2="4" />
			<line x1="9" y1="20" x2="9" y2="23" />
			<line x1="15" y1="20" x2="15" y2="23" />
			<line x1="20" y1="9" x2="23" y2="9" />
			<line x1="20" y1="14" x2="23" y2="14" />
			<line x1="1" y1="9" x2="4" y2="9" />
			<line x1="1" y1="14" x2="4" y2="14" />
			break;

		case "plus":
			<line x1="12" y1="5" x2="12" y2="19" />
			<line x1="5" y1="12" x2="19" y2="12" />
			break;

		case "save":
			<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
			<polyline points="17 21 17 13 7 13 7 21" />
			<polyline points="7 3 7 8 15 8" />
			break;

		case "check":
			<polyline points="20 6 9 17 4 12" />
			break;

		case "x":
			<line x1="18" y1="6" x2="6" y2="18" />
			<line x1="6" y1="6" x2="18" y2="18" />
			break;

		case "alert":
		case "warning":
			<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
			<line x1="12" y1="9" x2="12" y2="13" />
			<line x1="12" y1="17" x2="12.01" y2="17" />
			break;

		case "shield":
			<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
			break;

		case "download":
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
			<polyline points="7 10 12 15 17 10" />
			<line x1="12" y1="15" x2="12" y2="3" />
			break;

		case "trash":
			<polyline points="3 6 5 6 21 6" />
			<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
			break;

		case "refresh":
			<polyline points="23 4 23 10 17 10" />
			<polyline points="1 20 1 14 7 14" />
			<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
			break;

		case "play":
			<polygon points="5 3 19 12 5 21 5 3" />
			break;

		case "location":
			<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
			<circle cx="12" cy="10" r="3" />
			break;

		case "info":
			<circle cx="12" cy="12" r="10" />
			<line x1="12" y1="16" x2="12" y2="12" />
			<line x1="12" y1="8" x2="12.01" y2="8" />
			break;

		case "lightbulb":
			<path d="M9 18h6" />
			<path d="M10 22h4" />
			<path d="M12 2a7 7 0 0 0-7 7c0 2.5 1.5 4.5 3 6h8c1.5-1.5 3-3.5 3-6a7 7 0 0 0-7-7z" />
			break;

		case "users":
			<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
			<circle cx="9" cy="7" r="4" />
			<path d="M23 21v-2a4 4 0 0 0-3-3.87" />
			<path d="M16 3.13a4 4 0 0 1 0 7.75" />
			break;

		case "pairings":
			<line x1="14.5" y1="17.5" x2="3" y2="6" />
			<line x1="6" y1="3" x2="17.5" y2="14.5" />
			<line x1="17.5" y1="14.5" x2="21" y2="21" />
			<line x1="3" y1="6" x2="21" y2="21" opacity="0.3" />
			<polyline points="13 19 19 19 19 13" />
			<polyline points="5 11 11 11 11 5" />
			break;

		case "printer":
			<polyline points="6 9 6 2 18 2 18 9" />
			<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
			<rect x="6" y="14" width="12" height="8" />
			break;

		case "edit":
			<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
			<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
			break;

		case "swap":
			<polyline points="16 3 21 3 21 8" />
			<line x1="4" y1="20" x2="21" y2="3" />
			<polyline points="21 16 21 21 16 21" />
			<line x1="15" y1="15" x2="21" y2="21" />
			<line x1="4" y1="4" x2="9" y2="9" />
			break;

		case "medal":
			<circle cx="12" cy="8" r="6" />
			<path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11" />
			break;

		case "archive":
			<polyline points="21 8 21 21 3 21 3 8" />
			<rect x="1" y="3" width="22" height="5" />
			<line x1="10" y1="12" x2="14" y2="12" />
			break;

		case "unarchive":
			<polyline points="21 8 21 21 3 21 3 8" />
			<rect x="1" y="3" width="22" height="5" />
			<polyline points="10 12 12 10 14 12" />
			<line x1="12" y1="10" x2="12" y2="16" />
			break;

		default:
			LogUnknownName();
			break;
	}
</svg>

@code {
	[Parameter, EditorRequired] public string Name { get; set; } = "";
	[Parameter] public int Size { get; set; } = 16;
	[Parameter] public string Class { get; set; } = "";
	[Parameter] public double StrokeWidth { get; set; } = 2.0;

	/// <summary>Accessible name for a meaningful icon. Leave empty for decorative icons next to visible text.</summary>
	[Parameter] public string? Title { get; set; }

	// Unknown names render an empty icon; each one is logged once per process so a typo is visible in the debug log
	private static readonly ConcurrentDictionary<string, byte> ReportedUnknownNames = new(StringComparer.OrdinalIgnoreCase);

	private void LogUnknownName()
	{
		if (ReportedUnknownNames.TryAdd(Name, 0))
		{
			Logger.LogDebug("AppIcon has no glyph named \"{IconName}\"; rendering an empty icon.", Name);
		}
	}
}
