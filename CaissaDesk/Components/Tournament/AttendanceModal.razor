@namespace CaissaDesk.Components.Tournament
@using Caissa.Shared.Models
@using CaissaDesk.Core.Arbiter
@using CaissaDesk.Components.Icons
@using CaissaDesk.Localization
@inject IArbiterService ArbiterService
@inject ILocalizationService Loc
@implements IDisposable

@if (IsOpen && Tournament != null)
{
	<ModalDialog LabelledBy="@_titleId" OnCancel="CloseAsync" Style="max-width: 900px; max-height: 90vh;">
		<div class="modal-header">
			<div class="modal-title" id="@_titleId">
				<span style="color: var(--brand-gold);"><AppIcon Name="users" Size="18" /></span>
				<span>@Loc["Attendance_Title"]</span>
			</div>
			<button class="modal-close-btn" @onclick="CloseAsync" type="button" title="@Loc["Common_Close"]" aria-label="@Loc["Common_Close"]">
				<AppIcon Name="x" Size="15" />
			</button>
		</div>

		<div class="modal-body" style="display: flex; flex-direction: column; gap: 18px; overflow-y: auto;">
			<!-- Top Actions: Late Registration Toggle -->
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
				<div style="font-size: 13px; color: var(--text-secondary);">
					@Loc["Attendance_Subtitle"]
				</div>
				<button class="btn-secondary" @onclick="() => _showLateEntry = !_showLateEntry">
					<AppIcon Name="@(_showLateEntry ? "x" : "plus")" Size="13" />
					<span>@(_showLateEntry ? Loc["Attendance_HideLateReg"] : Loc["Attendance_LateReg"])</span>
				</button>
			</div>

			@if (_showLateEntry)
			{
				<!-- Late Registration Card -->
				<div class="panel-card" style="background-color: var(--bg-surface-elevated); border-left: 3px solid var(--brand-gold);">
					<div class="panel-title" style="margin-bottom: 8px;">@Loc["Attendance_LateRegTitle"]</div>
					<div style="display: grid; grid-template-columns: 1.5fr 1.5fr 1fr 1fr 1fr; gap: 10px; margin-bottom: 10px;">
						<div>
							<label class="form-label" for="@($"{_titleId}-last")">@Loc["Common_LastName"]</label>
							<input type="text" class="form-input" id="@($"{_titleId}-last")" placeholder="@Loc["Player_PlaceholderLastName"]" @bind="_lateLastName" />
						</div>
						<div>
							<label class="form-label" for="@($"{_titleId}-first")">@Loc["Common_FirstName"]</label>
							<input type="text" class="form-input" id="@($"{_titleId}-first")" placeholder="@Loc["Player_PlaceholderFirstName"]" @bind="_lateFirstName" />
						</div>
						<div>
							<label class="form-label" for="@($"{_titleId}-title")">@Loc["Common_Title"]</label>
							<select class="form-select" id="@($"{_titleId}-title")" @bind="_lateTitle">
								<option value="">@Loc["Common_None"]</option>
								@foreach (var titleCode in LocalizationExtensions.TitleCodes)
								{
									<option value="@titleCode">@titleCode</option>
								}
							</select>
						</div>
						<div>
							<label class="form-label" for="@($"{_titleId}-fed")">@Loc["Common_Federation"]</label>
							<input type="text" class="form-input" id="@($"{_titleId}-fed")" @bind="_lateFed" maxlength="3" />
						</div>
						<div>
							<label class="form-label" for="@($"{_titleId}-elo")">@Loc["Roster_FideElo"]</label>
							<input type="number" class="form-input" id="@($"{_titleId}-elo")" @bind="_lateRating" min="0" max="3000" />
						</div>
					</div>

					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
						<div style="display: flex; align-items: center; gap: 8px;">
							<label class="form-label" for="@($"{_titleId}-missed")" style="margin: 0;">@Loc["Attendance_MissedRounds"]</label>
							<select class="form-select" id="@($"{_titleId}-missed")" style="width: auto;" @bind="_lateByeType">
								<option value="@ByeType.HalfPoint">@Loc["Bye_HalfPerRound"]</option>
								<option value="@ByeType.ZeroPoint">@Loc["Bye_ZeroPerRound"]</option>
								<option value="@ByeType.None">@Loc["Bye_NoByes"]</option>
							</select>
						</div>

						<button class="btn-primary" @onclick="RegisterLatePlayerAsync" disabled="@(string.IsNullOrWhiteSpace(_lateLastName) && string.IsNullOrWhiteSpace(_lateFirstName))">
							<AppIcon Name="plus" Size="13" />
							<span>@Loc["Attendance_AddLateBtn"]</span>
						</button>
					</div>
				</div>
			}

			<!-- Player Attendance & Round Bye Grid -->
			<div class="data-table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th style="width: 40px; text-align: center;">#</th>
							<th>@Loc["Common_Name"]</th>
							<th style="width: 70px; text-align: right;">@Loc["Common_Rating"]</th>
							<th style="width: 95px; text-align: center;">@Loc["Common_Status"]</th>
							@for (int r = 1; r <= Tournament.TotalRounds; r++)
							{
								int roundNum = r;
								<th style="width: 65px; text-align: center;">@Loc["Attendance_RoundShort", roundNum]</th>
							}
							<th style="width: 100px; text-align: center;">@Loc["Common_Actions"]</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var player in Tournament.Players.OrderBy(p => p.StartRank))
						{
							bool isWithdrawn = player.Status == PlayerStatus.Withdrawn;
							<tr style="@(isWithdrawn ? "opacity: 0.6;" : "")">
								<td style="text-align: center; font-weight: 700; color: var(--text-secondary); font-family: var(--font-mono);">
									@player.StartRank
								</td>
								<td style="font-weight: 600;">
									@if (!string.IsNullOrEmpty(player.Title))
									{
										<span class="badge badge-gold" style="margin-right: 4px;">@player.Title</span>
									}
									<span>@player.FullName</span>
								</td>
								<td style="text-align: right; font-family: var(--font-mono); color: var(--text-secondary);">
									@(player.FideRating > 0 ? player.FideRating.ToString() : "-")
								</td>
								<td style="text-align: center;">
									<span class="@(player.Status == PlayerStatus.Active ? "badge badge-green" : "badge badge-gray")">
										@Loc.PlayerStatusLabel(player.Status)
									</span>
								</td>

								<!-- Round by Round advance bye selectors -->
								@for (int r = 1; r <= Tournament.TotalRounds; r++)
								{
									int roundNum = r;
									bool roundGenerated = Tournament.Rounds.Any(rnd => rnd.RoundNumber == roundNum);
									player.ByeRequests.TryGetValue(roundNum, out var currentBye);

									<td style="text-align: center; padding: 4px;">
										@if (isWithdrawn)
										{
											<span style="color: var(--text-muted); font-size: 11px;">-</span>
										}
										else if (roundGenerated)
										{
											<!-- Round already paired/generated -->
											var existingPairing = Tournament.Rounds
												.FirstOrDefault(rnd => rnd.RoundNumber == roundNum)?
												.Pairings.FirstOrDefault(p => p.WhitePlayerId == player.Id || p.BlackPlayerId == player.Id);

											if (existingPairing != null && existingPairing.IsBye)
											{
												<span class="badge badge-gold" style="font-size: 10px;" title="@existingPairing.Remarks">
													@Loc.ByeShortLabel(existingPairing.Result == MatchResult.ByeHalf ? ByeType.HalfPoint :
													  existingPairing.Result is MatchResult.ByeFull or MatchResult.ByeFullRequested ? ByeType.FullPoint : ByeType.ZeroPoint)
												</span>
											}
											else if (existingPairing != null)
											{
												<span class="badge badge-blue" style="font-size: 10px;" title="@Loc["Attendance_Paired"]">@Loc["Attendance_Paired"]</span>
											}
											else
											{
												<span style="color: var(--text-muted); font-size: 11px;">-</span>
											}
										}
										else
										{
											<!-- Future round: clickable bye cycle button -->
											<button type="button"
													class="@GetByeButtonClass(currentBye)"
													style="padding: 2px 6px; font-size: 11px; min-width: 44px; cursor: pointer;"
													title="@Loc["Attendance_CycleByeTooltip"]"
													aria-label="@Loc["Attendance_ByeCellLabel", player.FullName, roundNum, currentBye == ByeType.None ? Loc["Bye_NoByes"] : Loc.ByeShortLabel(currentBye)]"
													@onclick="() => CycleByeRequest(player, roundNum)">
												@Loc.ByeShortLabel(currentBye)
											</button>
										}
									</td>
								}

								<td style="text-align: center;">
									@if (player.Status == PlayerStatus.Active)
									{
										<button class="btn-danger" style="padding: 3px 8px; font-size: 11px;" title="@Loc["Attendance_WithdrawTooltip"]" @onclick="() => WithdrawPlayer(player.Id)">
											@Loc["Attendance_Withdraw"]
										</button>
									}
									else
									{
										<button class="btn-secondary" style="padding: 3px 8px; font-size: 11px;" title="@Loc["Attendance_ReactivateTooltip"]" @onclick="() => ReactivatePlayer(player.Id)">
											@Loc["Attendance_Reactivate"]
										</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		<div class="modal-footer">
			<button class="btn-primary" @onclick="CloseAsync">
				<span>@Loc["Common_Done"]</span>
			</button>
		</div>
	</ModalDialog>
}

@code {
	private readonly string _titleId = DomIds.Next("attendance-title");
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public Tournament? Tournament { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public EventCallback OnSaved { get; set; }

	private bool _showLateEntry = false;
	private string _lateLastName = "";
	private string _lateFirstName = "";
	private string _lateTitle = "";
	private string _lateFed = "SVK";
	private int _lateRating = 0;
	private ByeType _lateByeType = ByeType.HalfPoint;
	private bool _wasOpen;
	private Tournament? _loadedTournament;

	protected override void OnInitialized()
	{
		Loc.OnLanguageChanged += StateHasChanged;
	}

	protected override void OnParametersSet()
	{
		// Start with a clean late-registration form when the dialog opens or switches tournament, but keep
		// what is being typed across ordinary parent re-renders (e.g. after a bye toggle is saved).
		bool opened = IsOpen && !_wasOpen;
		bool otherTournament = IsOpen && !ReferenceEquals(Tournament, _loadedTournament);
		if (opened || otherTournament)
		{
			ResetLateEntryForm();
		}
		_wasOpen = IsOpen;
		_loadedTournament = IsOpen ? Tournament : null;
	}

	private void ResetLateEntryForm()
	{
		_showLateEntry = false;
		_lateLastName = "";
		_lateFirstName = "";
		_lateTitle = "";
		_lateFed = "SVK";
		_lateRating = 0;
		_lateByeType = ByeType.HalfPoint;
	}

	public void Dispose()
	{
		Loc.OnLanguageChanged -= StateHasChanged;
	}

	private async Task CloseAsync()
	{
		await OnClose.InvokeAsync();
	}

	private string GetByeButtonClass(ByeType bye) => bye switch
	{
		ByeType.HalfPoint => "badge badge-gold",
		ByeType.ZeroPoint => "badge badge-gray",
		ByeType.FullPoint => "badge badge-green",
		_ => "btn-secondary"
	};

	private async Task CycleByeRequest(Player player, int roundNumber)
	{
		if (Tournament == null) return;

		player.ByeRequests.TryGetValue(roundNumber, out var current);
		var nextBye = current switch
		{
			ByeType.None => ByeType.HalfPoint,
			ByeType.HalfPoint => ByeType.ZeroPoint,
			_ => ByeType.None
		};

		ArbiterService.SetAdvanceBye(Tournament, player.Id, roundNumber, nextBye);
		await OnSaved.InvokeAsync();
	}

	private async Task WithdrawPlayer(string playerId)
	{
		if (Tournament == null) return;
		ArbiterService.WithdrawPlayer(Tournament, playerId, Loc["Attendance_WithdrawnReason"]);
		await OnSaved.InvokeAsync();
	}

	private async Task ReactivatePlayer(string playerId)
	{
		if (Tournament == null) return;
		ArbiterService.ReactivatePlayer(Tournament, playerId);
		await OnSaved.InvokeAsync();
	}

	private async Task RegisterLatePlayerAsync()
	{
		if (Tournament == null || (string.IsNullOrWhiteSpace(_lateLastName) && string.IsNullOrWhiteSpace(_lateFirstName))) return;

		var player = new Player
		{
			LastName = _lateLastName.Trim(),
			FirstName = _lateFirstName.Trim(),
			Title = string.IsNullOrWhiteSpace(_lateTitle) ? null : _lateTitle.Trim(),
			Federation = string.IsNullOrWhiteSpace(_lateFed) ? "FID" : _lateFed.Trim().ToUpperInvariant(),
			FideRating = _lateRating,
			Status = PlayerStatus.Active
		};

		ArbiterService.AddLatePlayer(Tournament, player, _lateByeType);

		// Reset form
		_lateLastName = "";
		_lateFirstName = "";
		_lateTitle = "";
		_lateRating = 0;
		_showLateEntry = false;

		await OnSaved.InvokeAsync();
	}
}
