						}

						var (nLast, nFirst) = Player.SplitFullName(nationalCard.FullName);
						if (string.IsNullOrWhiteSpace(_editLastName)) _editLastName = nLast;
						if (string.IsNullOrWhiteSpace(_editFirstName)) _editFirstName = nFirst;
						if (string.IsNullOrWhiteSpace(_editFed) && !string.IsNullOrWhiteSpace(nationalCard.Federation))
