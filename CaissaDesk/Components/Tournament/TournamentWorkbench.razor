	private string GetMatchResultBadgeClass(MatchResult result) => result switch
	{
		MatchResult.NotPlayed => "btn-secondary",
		MatchResult.Draw => "badge badge-blue",
		MatchResult.WhiteWin or MatchResult.BlackWin => "badge badge-gold",
		MatchResult.WhiteForfeit or MatchResult.BlackForfeit or MatchResult.DoubleForfeit => "badge badge-gray",
		_ => "badge badge-gray"
	};

	private Dictionary<string, (double Points, int Games)> CalculateScores()
	{
		var dict = new Dictionary<string, (double Points, int Games)>();
		if (_tournament == null) return dict;

		foreach (var p in _tournament.Players)
		{
			dict[p.Id] = (0.0, 0);
		}

		foreach (var round in _tournament.Rounds)
		{
			foreach (var pairing in round.Pairings)
			{
				if (pairing.Result == MatchResult.NotPlayed) continue;

				var (wPts, bPts) = pairing.Result.ToPoints();

				if (!string.IsNullOrEmpty(pairing.WhitePlayerId) && dict.ContainsKey(pairing.WhitePlayerId))
				{
					var curr = dict[pairing.WhitePlayerId];
					dict[pairing.WhitePlayerId] = (curr.Points + wPts, curr.Games + 1);
				}

				if (!string.IsNullOrEmpty(pairing.BlackPlayerId) && dict.ContainsKey(pairing.BlackPlayerId))
				{
					var curr = dict[pairing.BlackPlayerId];
					dict[pairing.BlackPlayerId] = (curr.Points + bPts, curr.Games + 1);
				}
			}
		}

		return dict;
	}

	private string GetHeadToHeadResult(string player1Id, string player2Id)
	{
		if (_tournament == null) return "-";

		foreach (var round in _tournament.Rounds)
		{
			var match = round.Pairings.FirstOrDefault(p =>
				(p.WhitePlayerId == player1Id && p.BlackPlayerId == player2Id) ||
				(p.WhitePlayerId == player2Id && p.BlackPlayerId == player1Id));

			if (match == null || match.Result == MatchResult.NotPlayed) continue;

			var (wPts, bPts) = match.Result.ToPoints();
			if (match.WhitePlayerId == player1Id)
			{
				return wPts switch
				{
					1.0 => "1",
					0.5 => "½",
					0.0 => "0",
					_ => "-"
				};
			}
			else
			{
				return bPts switch
				{
					1.0 => "1",
					0.5 => "½",
					0.0 => "0",
					_ => "-"
				};
			}
		}

		return "-";
	}

