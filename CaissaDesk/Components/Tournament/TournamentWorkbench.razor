		bool willFinish = !_tournament.IsFinished;
		_confirmTitle = willFinish ? Loc["Confirm_ArchiveTournamentTitle"] : Loc["Confirm_UnarchiveTournamentTitle"];
		_confirmMessage = willFinish ? Loc["Confirm_ArchiveTournamentMsg", _tournament.Name] : Loc["Confirm_UnarchiveTournamentMsg", _tournament.Name];
		_confirmDetails = null;
		_confirmConfirmText = willFinish ? Loc["Workbench_MarkFinishedBtn"] : Loc["Workbench_RestoreActiveBtn"];
		_confirmHeaderIcon = willFinish ? "archive" : "unarchive";
		_confirmIcon = willFinish ? "archive" : "unarchive";
		_confirmIsDestructive = false;
		_confirmAction = () => ToggleWorkbenchFinishedAsync();
