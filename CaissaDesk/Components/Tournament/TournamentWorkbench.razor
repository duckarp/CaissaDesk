				   OnClose="() => _showResultDialog = false"
				   OnResultSaved="HandleResultSaved" />

<!-- Modal: Attendance, Byes & Player Status -->
<AttendanceModal IsOpen="_showAttendanceModal"
				 Tournament="_tournament"
				 OnClose="() => _showAttendanceModal = false"
				 OnSaved="HandleAttendanceSaved" />

<!-- Modal: Arbiter Manual Board Pairing -->
<ManualPairingModal IsOpen="_showManualPairingModal"
