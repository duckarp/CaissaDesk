@namespace CaissaDesk.Components.Tournament
@using Caissa.Shared.Models
@using CaissaDesk.Core.PairingEngine
@using Caissa.Shared.Tiebreak
@using CaissaDesk.Core.Arbiter
@using CaissaDesk.Data
@using CaissaDesk.Localization
@inject ITournamentRepository TournamentRepo
@inject IFideScoutingService FideService
@inject INationalScoutingService NationalService
@inject ITiebreakService TiebreakService
@inject IPairingEngineRegistry EngineRegistry
@inject IEngineInstallerService EngineInstaller
@inject IArbiterService ArbiterService
@inject IJSRuntime JS
@inject ILocalizationService Loc
@inject WorkspaceState Workspace
@inject IFileExportService FileExport
@inject ICaissaResultsSyncService CaissaResultsSync
@inject IAppSettingsService AppSettingsService
@implements IDisposable

<div class="tournament-workbench" style="display: flex; flex-direction: column; height: 100%; width: 100%; overflow: hidden; background-color: var(--bg-canvas);">
	@if (_isLoading)
	{
		<div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
			<div class="app-splash-spinner" style="margin: 0 auto 12px;"></div>
			<div>@Loc["Workbench_Loading"]</div>
		</div>
	}
	else if (_tournament == null)
	{
		<div class="panel-card" style="text-align: center; padding: 48px 24px; max-width: 480px; margin: 40px auto;">
			<div style="color: var(--accent-danger-hover); margin-bottom: 12px;"><AppIcon Name="warning" Size="32" /></div>
			<div style="font-weight: 700; font-size: 16px; color: var(--text-primary); margin-bottom: 8px;">@Loc["Workbench_NotFoundTitle"]</div>
			<div style="color: var(--text-secondary); font-size: 13px; margin-bottom: 20px;">@Loc["Workbench_NotFoundDesc"]</div>
			<button class="btn-primary" @onclick="() => Workspace.CloseTab(Tab.Id)">
				<span>@Loc["Workbench_CloseTab"]</span>
			</button>
		</div>
	}
	else
	{
		<!-- Workbench Top Control Bar -->
		<header style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-subtle); padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; flex-wrap: wrap; gap: 12px;">
			<div style="display: flex; align-items: center; gap: 14px;">
				<div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(250, 204, 21, 0.15); color: var(--brand-gold); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
					<AppIcon Name="trophy" Size="20" />
				</div>
				<div>
					<div style="display: flex; align-items: center; gap: 10px;">
						<h2 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin: 0; line-height: 1.2;">
							@_tournament.Name
						</h2>
						@if (_tournament.FideRated)
						{
							<span class="badge badge-gold" title="FIDE Rated Tournament">FIDE</span>
						}
						@if (_tournament.IsFinished)
						{
							<span class="badge badge-gray" style="font-size: 11px; display: inline-flex; align-items: center; gap: 4px;">
								<AppIcon Name="archive" Size="11" />
								<span>@Loc["Workbench_FinishedBadge"]</span>
							</span>
						}
					</div>
					<div style="display: flex; align-items: center; gap: 12px; margin-top: 3px; font-size: 12px; color: var(--text-secondary);">
						<span>@(_tournament.System == TournamentSystem.SwissDutch ? Loc["Tournament_SwissDutch"] : Loc["Tournament_RoundRobin"])</span>
						<span>•</span>
						<span>@_tournament.TimeControl (@_tournament.TimeControlDetails)</span>
						<span>•</span>
						<span>@Loc["Workbench_TotalRounds", _tournament.TotalRounds]</span>
						@if (!string.IsNullOrEmpty(_tournament.ChiefArbiter))
						{
							<span>•</span>
							<span>@Loc["Workbench_ArbiterLabel", _tournament.ChiefArbiter]</span>
						}
					</div>
				</div>
			</div>

			<!-- Sub-view Navigation Pills -->
			<div style="display: flex; align-items: center; gap: 10px;">
				<div style="display: flex; align-items: center; background-color: var(--bg-surface-elevated); padding: 3px; border-radius: 6px; border: 1px solid var(--border-subtle);">
					<button class="@GetNavButtonClass(TournamentView.Roster)" @onclick="() => SetView(TournamentView.Roster)">
						<AppIcon Name="users" Size="13" />
						<span>@Loc["Workbench_PlayersTab", _tournament.Players.Count]</span>
					</button>
					<button class="@GetNavButtonClass(TournamentView.Pairings)" @onclick="() => SetView(TournamentView.Pairings)">
						<AppIcon Name="pairings" Size="13" />
						<span>@Loc["Workbench_RoundsTab", _tournament.Rounds.Count]</span>
					</button>
					<button class="@GetNavButtonClass(TournamentView.Standings)" @onclick="() => SetView(TournamentView.Standings)">
						<AppIcon Name="medal" Size="13" />
						<span>@Loc["Nav_Standings"]</span>
					</button>
					<button class="@GetNavButtonClass(TournamentView.Settings)" @onclick="() => SetView(TournamentView.Settings)">
						<AppIcon Name="settings" Size="13" />
						<span>@Loc["Nav_Settings"]</span>
					</button>
				</div>

				<button class="btn-secondary" style="height: 34px; padding: 0 12px; gap: 6px;" title="@Loc["Workbench_PrintReports"]" @onclick="() => _showPrintModal = true">
					<AppIcon Name="printer" Size="14" />
					<span>@Loc["Workbench_PrintReports"]</span>
				</button>

				@{
					bool isSyncEnabled = CaissaResultsSync.IsSyncConfigured;
				}
				<button class="btn-secondary" 
						style="height: 34px; padding: 0 12px; gap: 6px; @(isSyncEnabled ? "border-color: rgba(16, 185, 129, 0.4); color: #34d399;" : "opacity: 0.6; color: var(--text-muted);")" 
						title="@(isSyncEnabled ? "Publish to CaissaResults Web Portal" : "Syncing disabled: Configure API key in Settings")" 
						@onclick="PublishToCaissaResultsAsync" 
						disabled="@(_isSyncingToWeb || !isSyncEnabled)">
					@if (_isSyncingToWeb)
					{
						<span class="app-splash-spinner" style="width: 12px; height: 12px; margin: 0;"></span>
						<span>Syncing...</span>
					}
					else
					{
						<AppIcon Name="cloud" Size="14" />
						<span>Publish to Web</span>
					}
				</button>

				@if (_hasPublishedToWeb)
				{
					<button class="btn-secondary" style="height: 34px; padding: 0 10px; gap: 6px; color: var(--accent-info-hover);" title="Open in CaissaResults Web Portal" @onclick="OpenWebPortal">
						<AppIcon Name="globe" Size="14" />
						<span>View Web</span>
					</button>
				}
			</div>
		</header>

		@if (!string.IsNullOrEmpty(_webSyncStatusMessage))
		{
			<div style="margin: 12px 20px 0 20px; padding: 8px 14px; border-radius: 6px; font-size: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; @(_hasPublishedToWeb ? "background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;" : "background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;")">
				<div style="display: flex; align-items: center; gap: 8px;">
					<AppIcon Name="@(_hasPublishedToWeb ? "check" : "alert")" Size="14" />
					<span>@_webSyncStatusMessage</span>
				</div>
				<button style="background: none; border: none; cursor: pointer; color: inherit; opacity: 0.7; padding: 2px;" @onclick="() => _webSyncStatusMessage = null">✕</button>
			</div>
		}

		<!-- Sub-view Content Body -->
		<div style="flex: 1; overflow-y: auto; padding: 20px;">
			@if (Tab.CurrentView == TournamentView.Roster)
			{
				<!-- ROSTER VIEW -->
				<div style="display: flex; flex-direction: column; gap: 16px;">
					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
						<div>
							<h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0;">@Loc["Roster_Title"]</h3>
							<div style="font-size: 12px; color: var(--text-secondary);">@Loc["Roster_Count", _tournament.Players.Count]</div>
						</div>

						<div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
							<button class="btn-secondary" @onclick="SyncAllPlayersFromFideAsync" disabled="@(_isSyncingAllFide || _tournament.Players.Count == 0)" title="@Loc["Roster_SyncFideTooltip"]">
								<AppIcon Name="refresh" Size="13" />
								<span>@(_isSyncingAllFide ? Loc["Roster_SyncingFideProgress", _syncProgressCurrent, _syncProgressTotal] : Loc["Roster_SyncFideBtn"])</span>
							</button>
							<button class="btn-secondary" @onclick="() => _showAttendanceModal = true" title="@Loc["Roster_AttendanceByes"]">
								<AppIcon Name="checklist" Size="13" />
								<span>@Loc["Roster_AttendanceByes"]</span>
							</button>
							<button class="btn-secondary" @onclick="ReseedPlayersAsync" title="@Loc["Roster_Reseed"]">
								<AppIcon Name="refresh" Size="13" />
								<span>@Loc["Roster_Reseed"]</span>
							</button>
							<button class="btn-primary" @onclick="() => { ResetNewPlayerForm(); _showAddPlayerModal = true; }">
								<AppIcon Name="plus" Size="14" />
								<span>@Loc["Roster_RegisterPlayer"]</span>
							</button>
						</div>
					</div>

					@if (!string.IsNullOrEmpty(_syncResultMessage))
					{
						<div class="panel-card" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(76, 175, 80, 0.1); border: 1px solid rgba(76, 175, 80, 0.3); border-radius: 6px; font-size: 13px; color: var(--accent-success);">
							<div style="display: flex; align-items: center; gap: 8px;">
								<AppIcon Name="checkmark" Size="14" />
								<span>@_syncResultMessage</span>
							</div>
							<button class="modal-close-btn" @onclick="() => _syncResultMessage = null" style="font-size: 12px; color: var(--text-secondary);">
								<AppIcon Name="x" Size="12" />
							</button>
						</div>
					}

					@if (_tournament.Players.Count == 0)
					{
						<div class="panel-card" style="text-align: center; padding: 40px 20px;">
							<div style="color: var(--brand-gold); margin-bottom: 8px;"><AppIcon Name="users" Size="32" /></div>
							<div style="font-weight: 600; font-size: 15px; color: var(--text-primary); margin-bottom: 4px;">@Loc["Roster_EmptyTitle"]</div>
							<div style="color: var(--text-secondary); font-size: 12px; margin-bottom: 16px;">@Loc["Roster_EmptyDesc"]</div>
							<button class="btn-primary" @onclick="() => { ResetNewPlayerForm(); _showAddPlayerModal = true; }">
								<AppIcon Name="plus" Size="13" />
								<span>@Loc["Roster_AddFirstPlayer"]</span>
							</button>
						</div>
					}
					else
					{
						<div class="data-table-container">
							<table class="data-table">
								<thead>
									<tr>
										<th style="width: 45px; text-align: center;">#</th>
										<th style="width: 60px;">@Loc["Common_Title"]</th>
										<th>@Loc["Common_Name"]</th>
										<th style="width: 60px; text-align: center;">Fed</th>
										<th>@Loc["Common_Club"]</th>
										<th style="width: 80px; text-align: right;">@Loc["Roster_FideElo"]</th>
										<th style="width: 80px; text-align: right;">@Loc["Roster_NatElo"]</th>
										<th style="width: 65px; text-align: center;">@Loc["Common_Born"]</th>
										<th style="width: 85px; text-align: center;">@Loc["Common_Status"]</th>
										<th style="width: 85px; text-align: center;">@Loc["Common_Actions"]</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var player in _tournament.Players.OrderBy(p => p.StartRank))
									{
										<tr>
											<td style="text-align: center; font-weight: 700; color: var(--text-secondary); font-family: var(--font-mono);">
												@player.StartRank
											</td>
											<td>
												@if (!string.IsNullOrEmpty(player.Title))
												{
													<span class="badge badge-gold">@player.Title</span>
												}
											</td>
											<td style="font-weight: 600;">
												<div>@player.FullName</div>
												@if (!string.IsNullOrEmpty(player.FideId))
												{
													<div style="font-size: 10px; font-family: var(--font-mono); color: var(--text-secondary); font-weight: normal;">
														FIDE: @player.FideId
													</div>
												}
											</td>
											<td style="text-align: center; font-family: var(--font-mono); font-size: 11px;">
												<span class="badge badge-gray">@player.Federation</span>
											</td>
											<td style="color: var(--text-secondary);">
												@(string.IsNullOrEmpty(player.Club) ? "-" : player.Club)
											</td>
											<td style="text-align: right; font-family: var(--font-mono); font-weight: 600;">
												@(player.FideRating > 0 ? player.FideRating.ToString() : "-")
											</td>
											<td style="text-align: right; font-family: var(--font-mono); color: var(--text-secondary);">
												@(player.NationalRating > 0 ? player.NationalRating.ToString() : "-")
											</td>
											<td style="text-align: center; color: var(--text-secondary); font-family: var(--font-mono); font-size: 12px;">
												@(player.BirthYear.HasValue ? player.BirthYear.Value.ToString() : "-")
											</td>
											<td style="text-align: center;">
												<span class="@(player.Status == PlayerStatus.Active ? "badge badge-green" : "badge badge-gray")">
													@player.Status
												</span>
											</td>
											<td style="text-align: center; white-space: nowrap;">
												<button class="btn-secondary" style="padding: 3px 6px; font-size: 11px; margin-right: 4px;" title="@Loc["Common_Edit"]" @onclick="() => OpenEditPlayerModal(player)">
													<AppIcon Name="edit" Size="11" />
												</button>
												<button class="btn-danger" style="padding: 3px 6px; font-size: 11px;" title="@Loc["Common_Delete"]" @onclick="() => RequestRemovePlayer(player.Id, player.FullName)">
													<AppIcon Name="trash" Size="11" />
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			}
			else if (Tab.CurrentView == TournamentView.Pairings)
			{
				<!-- PAIRINGS VIEW -->
				<div style="display: flex; flex-direction: column; gap: 16px;">
					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
						<div>
							<h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0;">@Loc["Pairings_Title"]</h3>
							<div style="font-size: 12px; color: var(--text-secondary);">@Loc["Pairings_ClickToEnter"]</div>
						</div>

						<div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
							<span class="badge badge-gray" style="font-size: 11px;">
								@Loc["Pairings_Engine", GetActiveEngineName()]
							</span>

							<button class="@(_arbiterMode ? "btn-primary" : "btn-secondary")" @onclick="() => _arbiterMode = !_arbiterMode" title="@Loc["Pairings_ArbiterMode"]">
								<AppIcon Name="edit" Size="13" />
								<span>@(_arbiterMode ? Loc["Pairings_ArbiterModeOn"] : Loc["Pairings_ArbiterMode"])</span>
							</button>

							@if (_arbiterMode && _tournament.Rounds.Count > 0)
							{
								<button class="btn-secondary" @onclick="OpenAddManualPairingModal" title="@Loc["Pairings_ManualBoard"]">
									<AppIcon Name="plus" Size="13" />
									<span>@Loc["Pairings_ManualBoard"]</span>
								</button>
							}

							@if (_tournament.Rounds.Count == 0)
							{
								<button class="btn-primary" @onclick="GeneratePairingsAsync" disabled="@(_tournament.Players.Count < 2)">
									<AppIcon Name="pairings" Size="14" />
									<span>@Loc["Pairings_Generate"]</span>
								</button>
							}
							else
							{
								@if (_tournament.System == TournamentSystem.SwissDutch && _tournament.Rounds.Count < _tournament.TotalRounds)
								{
									var latestRound = _tournament.Rounds.OrderBy(r => r.RoundNumber).LastOrDefault();
									int unplayedCount = latestRound?.Pairings.Count(p => p.Result == MatchResult.NotPlayed) ?? 0;
									bool isPending = latestRound != null && unplayedCount > 0;

									<button class="@(isPending ? "btn-secondary" : "btn-primary")"
											@onclick="GenerateNextRoundAsync"
											title="@(isPending ? $"Round {latestRound?.RoundNumber} has {unplayedCount} match(es) in progress. Click to view pending games." : $"Generate FIDE Dutch pairings for Round {_tournament.Rounds.Count + 1}")">
										@if (isPending)
										{
											<span style="color: var(--brand-gold);"><AppIcon Name="warning" Size="13" /></span>
										}
										else
										{
											<AppIcon Name="plus" Size="13" />
										}
										<span>@Loc["Pairings_PairRound", _tournament.Rounds.Count + 1]</span>
										@if (isPending)
										{
											<span class="badge badge-gray" style="font-size: 10px; margin-left: 2px;">@Loc["Pairings_Pending", unplayedCount]</span>
										}
									</button>
								}
								@if (!HasAnyResultsEntered())
								{
									<button class="btn-secondary" @onclick="RequestRegeneratePairings" title="@Loc["Pairings_ResetRegenerate"]">
										<AppIcon Name="refresh" Size="13" />
										<span>@Loc["Pairings_ResetRegenerate"]</span>
									</button>
								}
								else
								{
									int currentRoundNumber = GetCurrentRoundNumber();
									<button class="btn-secondary" @onclick="() => RequestResetRound(currentRoundNumber)" title="@Loc["Pairings_ResetRound", currentRoundNumber]">
										<AppIcon Name="refresh" Size="13" />
										<span>@Loc["Pairings_ResetRound", currentRoundNumber]</span>
									</button>
									@if (_arbiterMode && _tournament.System == TournamentSystem.SwissDutch && _tournament.Rounds.Count > 1)
									{
										<button class="btn-secondary" style="color: var(--accent-danger);" @onclick="() => RequestDeleteRound(currentRoundNumber)" title="@Loc["Pairings_DeleteRound", currentRoundNumber]">
											<AppIcon Name="trash" Size="13" />
											<span>@Loc["Pairings_DeleteRound", currentRoundNumber]</span>
										</button>
									}
								}
							}
						</div>
					</div>

					@if (!string.IsNullOrEmpty(_pairingErrorMessage))
					{
						<div class="panel-card" style="background: rgba(218, 54, 51, 0.15); border: 1px solid var(--accent-danger-hover); padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
							<div style="display: flex; align-items: center; gap: 8px; color: #f87171; font-size: 13px;">
								<AppIcon Name="warning" Size="16" />
								<span>@_pairingErrorMessage</span>
							</div>
							<button class="modal-close-btn" style="color: #f87171; width: 24px; height: 24px;" @onclick="() => _pairingErrorMessage = null" type="button" title="@Loc["Common_Dismiss"]">
								<AppIcon Name="x" Size="13" />
							</button>
						</div>
					}

					@if (_tournament.Rounds.Count == 0)
					{
						<div class="panel-card" style="text-align: center; padding: 48px 24px;">
							<div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(31, 111, 235, 0.12); color: var(--accent-blue-hover); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;">
								<AppIcon Name="pairings" Size="26" />
							</div>
							<h4 style="font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px;">@Loc["Pairings_EmptyTitle"]</h4>
							<p style="color: var(--text-secondary); font-size: 13px; max-width: 460px; margin: 0 auto 16px;">
								@(_tournament.System == TournamentSystem.RoundRobin
									? Loc["Pairings_EmptyRR"]
									: Loc["Pairings_EmptySwiss"])
							</p>
							<button class="btn-primary" @onclick="GeneratePairingsAsync" disabled="@(_tournament.Players.Count < 2)">
								<AppIcon Name="pairings" Size="14" />
								<span>@Loc["Pairings_GenerateNow"]</span>
							</button>
						</div>
					}
					else
					{
						<!-- Round Selector Bar -->
						<div style="display: flex; align-items: center; gap: 6px; overflow-x: auto; padding-bottom: 4px;">
							@foreach (var round in _tournament.Rounds.OrderBy(r => r.RoundNumber))
							{
								bool isActiveRound = round.RoundNumber == _activeRoundNumber;
								int completedMatches = round.Pairings.Count(p => p.Result != MatchResult.NotPlayed);
								<button class="@(isActiveRound ? "workspace-tab tab-active" : "workspace-tab")"
										style="font-size: 13px; height: 32px;"
										@onclick="() => _activeRoundNumber = round.RoundNumber">
									<span>@Loc["Pairings_RoundNum", round.RoundNumber]</span>
									<span class="badge @(completedMatches == round.Pairings.Count ? "badge-green" : "badge-gray")" style="font-size: 10px; padding: 0 4px;">
										@completedMatches/@round.Pairings.Count
									</span>
								</button>
							}
						</div>

						<!-- Pairings Board Table for Active Round -->
						var activeRound = _tournament.Rounds.FirstOrDefault(r => r.RoundNumber == _activeRoundNumber);
						if (activeRound != null)
						{
							<div class="data-table-container">
								<table class="data-table">
									<thead>
										<tr>
											<th style="width: 65px; text-align: center;">@Loc["Common_Board"]</th>
											<th style="text-align: right; width: 36%;">@Loc["Pairings_WhitePlayer"]</th>
											<th style="width: 130px; text-align: center;">@Loc["Common_Result"]</th>
											<th style="width: 36%;">@Loc["Pairings_BlackPlayer"]</th>
											<th>@Loc["Pairings_Remarks"]</th>
											@if (_arbiterMode)
											{
												<th style="width: 100px; text-align: center;">@Loc["Common_Arbiter"]</th>
											}
										</tr>
									</thead>
									<tbody>
										@foreach (var pairing in activeRound.Pairings.OrderBy(p => p.BoardNumber))
										{
											var white = _tournament.GetPlayer(pairing.WhitePlayerId);
											var black = _tournament.GetPlayer(pairing.BlackPlayerId);

											<tr>
												<td style="text-align: center; font-weight: 700; color: var(--text-secondary); font-family: var(--font-mono);">
													<span>@pairing.BoardNumber</span>
													@if (pairing.IsManualOverride)
													{
														<span class="badge badge-gold" style="font-size: 9px; padding: 1px 3px; margin-left: 3px;" title="Manual Arbiter Override">M</span>
													}
												</td>

												<!-- White Player Cell -->
												<td style="text-align: right;">
													@if (white != null)
													{
														<div style="display: inline-flex; align-items: center; gap: 8px;">
															@if (!string.IsNullOrEmpty(white.Title))
															{
																<span class="badge badge-gold">@white.Title</span>
															}
															<span style="font-weight: 600;">@white.FullName</span>
															<span style="font-size: 12px; color: var(--text-secondary); font-family: var(--font-mono);">
																(@(white.FideRating > 0 ? white.FideRating.ToString() : "-"))
															</span>
															<span style="color: #ffffff; font-size: 14px;" title="White">♔</span>
														</div>
													}
													else
													{
														<span style="color: var(--text-muted); font-style: italic;">BYE</span>
													}
												</td>

												<!-- Result Button Cell -->
												<td style="text-align: center;">
													<button class="@GetMatchResultBadgeClass(pairing.Result)"
															style="cursor: pointer; min-width: 80px; justify-content: center;"
															title="Click to enter or change score"
															@onclick="() => OpenResultDialog(pairing)">
														<span style="font-size: 13px; font-weight: 700; font-family: var(--font-mono);">
															@pairing.Result.ToDisplayString()
														</span>
													</button>
												</td>

												<!-- Black Player Cell -->
												<td>
													@if (black != null)
													{
														<div style="display: inline-flex; align-items: center; gap: 8px;">
															<span style="color: #64748b; font-size: 14px;" title="Black">♚</span>
															<span style="font-weight: 600;">@black.FullName</span>
															@if (!string.IsNullOrEmpty(black.Title))
															{
																<span class="badge badge-gold">@black.Title</span>
															}
															<span style="font-size: 12px; color: var(--text-secondary); font-family: var(--font-mono);">
																(@(black.FideRating > 0 ? black.FideRating.ToString() : "-"))
															</span>
														</div>
													}
													else
													{
														<span style="color: var(--text-muted); font-style: italic;">BYE</span>
													}
												</td>

												<!-- Remarks -->
												<td style="font-size: 11px; color: var(--text-muted);">
													@(pairing.Remarks ?? "")
												</td>

												@if (_arbiterMode)
												{
													<td style="text-align: center; white-space: nowrap;">
														@if (!pairing.IsBye)
														{
															<button class="btn-secondary" style="padding: 2px 5px; font-size: 11px; margin-right: 3px;" title="@Loc["Pairings_SwapColors"]" @onclick="() => SwapColorsAsync(activeRound, pairing.BoardNumber)">
																<AppIcon Name="swap" Size="11" />
															</button>
														}
														<button class="btn-secondary" style="padding: 2px 5px; font-size: 11px; margin-right: 3px;" title="@Loc["Pairings_EditBoard"]" @onclick="() => OpenEditPairingModal(pairing)">
															<AppIcon Name="edit" Size="11" />
														</button>
														<button class="btn-danger" style="padding: 2px 5px; font-size: 11px;" title="@Loc["Pairings_DeleteBoard"]" @onclick="() => RequestDeletePairing(activeRound, pairing)">
															<AppIcon Name="trash" Size="11" />
														</button>
													</td>
												}
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					}
				</div>
			}
			else if (Tab.CurrentView == TournamentView.Standings)
			{
				<!-- STANDINGS VIEW -->
				var playerScores = CalculateScores();

				<div style="display: flex; flex-direction: column; gap: 16px;">
					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
						<div>
							<h3 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0;">@Loc["Standings_Title"]</h3>
							<div style="font-size: 12px; color: var(--text-secondary);">@Loc["Standings_Subtitle"]</div>
						</div>

						@if (_tournament.System == TournamentSystem.RoundRobin)
						{
							<div style="display: flex; align-items: center; background-color: var(--bg-surface-elevated); padding: 3px; border-radius: 6px; border: 1px solid var(--border-subtle);">
								<button class="@(!_showCrossTable ? "workspace-tab tab-active" : "workspace-tab")" @onclick="() => _showCrossTable = false">
									@Loc["Standings_Leaderboard"]
								</button>
								<button class="@(_showCrossTable ? "workspace-tab tab-active" : "workspace-tab")" @onclick="() => _showCrossTable = true">
									@Loc["Standings_CrossTable"]
								</button>
							</div>
						}
					</div>

					@if (_showCrossTable && _tournament.System == TournamentSystem.RoundRobin)
					{
						<!-- Berger Cross-Table Matrix N x N -->
						<div class="data-table-container">
							<table class="data-table" style="table-layout: fixed;">
								<thead>
									<tr>
										<th style="width: 40px; text-align: center;">#</th>
										<th style="width: 180px;">@Loc["Common_Name"]</th>
										@foreach (var p in _tournament.Players.OrderBy(p => p.StartRank))
										{
											<th style="width: 36px; text-align: center; font-family: var(--font-mono);">@p.StartRank</th>
										}
										<th style="width: 55px; text-align: right;">@Loc["Common_Points"]</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var pRow in _tournament.Players.OrderBy(p => p.StartRank))
									{
										var score = playerScores.GetValueOrDefault(pRow.Id, (Points: 0.0, Games: 0));
										<tr>
											<td style="text-align: center; font-weight: 700; color: var(--text-secondary); font-family: var(--font-mono);">
												@pRow.StartRank
											</td>
											<td style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
												@pRow.FullName
											</td>
											@foreach (var pCol in _tournament.Players.OrderBy(p => p.StartRank))
											{
												if (pRow.Id == pCol.Id)
												{
													<td style="text-align: center; background-color: var(--bg-surface-active); color: var(--text-muted); font-size: 11px;">✕</td>
												}
												else
												{
													string cellResult = GetHeadToHeadResult(pRow.Id, pCol.Id);
													<td style="text-align: center; font-family: var(--font-mono); font-weight: 700; font-size: 12px; color: @GetCellColor(cellResult);">
														@cellResult
													</td>
												}
											}
											<td style="text-align: right; font-weight: 800; color: var(--brand-gold); font-family: var(--font-mono);">
												@score.Points.ToString("0.0")
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
					else
					{
						<!-- Leaderboard Table with Dynamic FIDE Tiebreaks -->
						var standings = TiebreakService.CalculateStandings(_tournament);
						var tiebreaksToShow = _tournament.TiebreakOrder;

						<div class="data-table-container">
							<table class="data-table">
								<thead>
									<tr>
										<th style="width: 50px; text-align: center;">@Loc["Common_Rank"]</th>
										<th style="width: 50px; text-align: center;">@Loc["Common_Seed"]</th>
										<th style="width: 60px;">@Loc["Common_Title"]</th>
										<th>@Loc["Common_Name"]</th>
										<th style="width: 65px; text-align: center;">Fed</th>
										<th style="width: 75px; text-align: right;">@Loc["Common_Rating"]</th>
										<th style="width: 65px; text-align: center;">@Loc["Common_Games"]</th>
										<th style="width: 75px; text-align: right;">@Loc["Common_Points"]</th>
										@foreach (var tb in tiebreaksToShow)
										{
											<th style="width: 75px; text-align: right;" title="@(Loc[$"Tiebreak_{tb}"] != $"Tiebreak_{tb}" ? Loc[$"Tiebreak_{tb}"] : tb.ToFullName())">@tb.ToShortName()</th>
										}
									</tr>
								</thead>
								<tbody>
									@foreach (var standing in standings)
									{
										<tr>
											<td style="text-align: center; font-weight: 800; color: var(--brand-gold); font-family: var(--font-mono);">
												@standing.Rank
											</td>
											<td style="text-align: center; color: var(--text-secondary); font-family: var(--font-mono);">
												@standing.Player.StartRank
											</td>
											<td>
												@if (!string.IsNullOrEmpty(standing.Player.Title))
												{
													<span class="badge badge-gold">@standing.Player.Title</span>
												}
											</td>
											<td style="font-weight: 600;">@standing.Player.FullName</td>
											<td style="text-align: center;"><span class="badge badge-gray">@standing.Player.Federation</span></td>
											<td style="text-align: right; font-family: var(--font-mono);">@standing.Player.EffectiveRating(_tournament.SeedingPrecedence)</td>
											<td style="text-align: center; color: var(--text-secondary); font-family: var(--font-mono);">@standing.GamesPlayed</td>
											<td style="text-align: right; font-weight: 800; color: var(--brand-gold); font-family: var(--font-mono); font-size: 14px;">
												@standing.Points.ToString("0.0")
											</td>
											@foreach (var tb in tiebreaksToShow)
											{
												<td style="text-align: right; font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary);">
													@standing.FormatTiebreak(tb)
												</td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			}
			else if (Tab.CurrentView == TournamentView.Settings)
			{
				<!-- SETTINGS VIEW -->
				<div style="max-width: 1720px; width: 100%; display: flex; flex-direction: column; gap: 18px;">
					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
						<h3 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin: 0;">@Loc["Settings_Config"]</h3>
						<button class="btn-primary" @onclick="SaveSettingsAsync">
							<AppIcon Name="save" Size="14" />
							<span>@Loc["Common_SaveChanges"]</span>
						</button>
					</div>

					@if (!string.IsNullOrEmpty(_settingsErrorMessage))
					{
						<div style="background-color: rgba(218, 54, 51, 0.12); border: 1px solid var(--accent-danger); border-radius: 6px; padding: 10px 14px; color: var(--accent-danger); font-size: 13px; display: flex; align-items: center; gap: 8px;">
							<AppIcon Name="alert" Size="16" />
							<span>@_settingsErrorMessage</span>
						</div>
					}
					@if (!string.IsNullOrEmpty(_settingsSuccessMessage))
					{
						<div style="background-color: rgba(35, 134, 54, 0.12); border: 1px solid var(--accent-primary); border-radius: 6px; padding: 10px 14px; color: var(--accent-primary); font-size: 13px; display: flex; align-items: center; gap: 8px;">
							<AppIcon Name="check" Size="16" />
							<span>@_settingsSuccessMessage</span>
						</div>
					}

					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(480px, 1fr)); gap: 20px; align-items: start;">
						<!-- Left Column: Lifecycle & General Info -->
						<div style="display: flex; flex-direction: column; gap: 18px;">
							<!-- Tournament Lifecycle & Status Card -->
							<div class="panel-card" style="display: flex; flex-direction: column; gap: 14px;">
								<div style="display: flex; align-items: center; justify-content: space-between;">
									<div>
										<div class="panel-title" style="margin-bottom: 2px;">@Loc["Workbench_LifecycleTitle"]</div>
										<div style="font-size: 12px; color: var(--text-secondary);">@Loc["Workbench_LifecycleDesc"]</div>
									</div>
									<span class="badge @(_tournament.IsFinished ? "badge-gray" : "badge-green")" style="font-size: 12px; padding: 4px 10px;">
										@(_tournament.IsFinished ? Loc["Workbench_StatusFinished"] : Loc["Workbench_StatusActive"])
									</span>
								</div>

								<div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 12px; margin-top: 2px;">
									<div style="font-size: 12px; color: var(--text-secondary);">
										@if (_tournament.IsFinished && _tournament.FinishedAt.HasValue)
										{
											<span>Finished on @_tournament.FinishedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
										}
										else
										{
											<span>@Loc["Workbench_StatusActive"]</span>
										}
									</div>
									@if (_tournament.IsFinished)
									{
										<button type="button" class="btn-secondary" @onclick="RequestToggleWorkbenchFinished">
											<AppIcon Name="unarchive" Size="13" />
											<span>@Loc["Workbench_RestoreActiveBtn"]</span>
										</button>
									}
									else
									{
										<button type="button" class="btn-secondary" @onclick="RequestToggleWorkbenchFinished">
											<AppIcon Name="archive" Size="13" />
											<span>@Loc["Workbench_MarkFinishedBtn"]</span>
										</button>
									}
								</div>
							</div>

							<!-- General Tournament Information Card -->
							<div class="panel-card" style="display: flex; flex-direction: column; gap: 14px;">
								<div class="panel-title">@Loc["Settings_General"]</div>

								<div class="form-group">
									<label class="form-label">@Loc["Tournament_Name"]</label>
									<input type="text" class="form-input" @bind="Details.Name" />
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_TotalRounds"]</label>
										<input type="number"
											   class="form-input"
											   style="@(Details.TotalRounds < _tournament.MinAllowedRounds ? "border-color: var(--accent-danger);" : "")"
											   @bind="Details.TotalRounds"
											   min="@_tournament.MinAllowedRounds"
											   max="50" />
										<div style="font-size: 11px; color: @(Details.TotalRounds < _tournament.MinAllowedRounds ? "var(--accent-danger)" : "var(--text-secondary)"); margin-top: 4px;">
											@Loc["Tournament_MinRoundsNotice", _tournament.MinAllowedRounds, _tournament.FinishedRoundsCount]
										</div>
									</div>
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_Venue"]</label>
										<input type="text" class="form-input" @bind="Details.Venue" placeholder="e.g. Chess Hall" />
									</div>
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_ChiefArbiter"]</label>
										<input type="text" class="form-input" @bind="Details.ChiefArbiter" placeholder="e.g. IA Tomas K." />
									</div>
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_DeputyArbiter"]</label>
										<input type="text" class="form-input" @bind="Details.DeputyArbiter" placeholder="e.g. FA John D." />
									</div>
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_Organizer"]</label>
										<input type="text" class="form-input" @bind="Details.Organizer" placeholder="e.g. Chess Club" />
									</div>
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_Federation"]</label>
										<input type="text" class="form-input" @bind="Details.Federation" placeholder="e.g. SVK" maxlength="3" />
									</div>
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_TimeControl"]</label>
										<select class="form-select" @bind="Details.TimeControl">
											<option value="@TimeControlCategory.Rapid">@Loc["TimeControl_Rapid"]</option>
											<option value="@TimeControlCategory.Blitz">@Loc["TimeControl_Blitz"]</option>
											<option value="@TimeControlCategory.Standard">@Loc["TimeControl_Standard"]</option>
										</select>
									</div>
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_TimeControlSpec"]</label>
										<input type="text" class="form-input" @bind="Details.TimeControlDetails" placeholder="e.g. 15m + 5s" />
									</div>
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_StartDate"]</label>
										<input type="date" class="form-input" value="@Details.StartDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateChanged" />
									</div>
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_EndDate"]</label>
										<input type="date" class="form-input" value="@Details.EndDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateChanged" />
									</div>
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
									<div class="form-group">
										<label class="form-label">@Loc["Tournament_SeedingPrecedence"]</label>
										<select class="form-select" @bind="Details.SeedingPrecedence">
											<option value="@SeedingPrecedence.FideFirst">@Loc["Tournament_FideFirst"]</option>
											<option value="@SeedingPrecedence.NationalFirst">@Loc["Tournament_NationalFirst"]</option>
										</select>
									</div>
									<div class="form-group" style="display: flex; align-items: flex-end; padding-bottom: 8px;">
										<div style="display: flex; align-items: center; gap: 8px;">
											<input type="checkbox" id="wbFideRated" @bind="Details.FideRated" style="cursor: pointer; width: 16px; height: 16px; accent-color: var(--brand-gold);" />
											<label for="wbFideRated" style="font-size: 13px; color: var(--text-primary); cursor: pointer; user-select: none;">
												@Loc["Tournament_FideRated"]
											</label>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Right Column: Engine Provider, Tiebreaks, Data Exchange -->
						<div style="display: flex; flex-direction: column; gap: 18px;">
							@if (_tournament.System == TournamentSystem.SwissDutch)
							{
								<!-- Pairing Engine Provider Card -->
								<div class="panel-card" style="display: flex; flex-direction: column; gap: 14px;">
									<div>
										<div class="panel-title" style="margin-bottom: 2px;">@Loc["Settings_EngineProvider"]</div>
										<div style="font-size: 12px; color: var(--text-secondary);">@Loc["Settings_EngineDesc"]</div>
									</div>

									@if (!string.IsNullOrEmpty(_engineDownloadMessage))
									{
										<div style="font-size: 12px; padding: 8px 12px; border-radius: 6px; background-color: rgba(218, 54, 51, 0.12); color: var(--accent-danger); margin-bottom: 8px;">
											@_engineDownloadMessage
										</div>
									}

									<div style="background-color: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 12px; font-size: 12px; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px;">
										<span style="color: var(--brand-gold); margin-top: 1px;"><AppIcon Name="lightbulb" Size="14" /></span>
										<div>
											<strong style="color: var(--text-primary);">@Loc["Settings_EngineGuideTitle"]:</strong>
											<span style="margin-left: 4px;">@Loc["Settings_EngineGuideSubtitle"]</span>
										</div>
									</div>

									<div style="display: flex; flex-direction: column; gap: 8px;">
										@foreach (var engine in EngineRegistry.SwissEngines)
										{
											bool isSelected = _tournament.PairingEngineId.Equals(engine.Id, StringComparison.OrdinalIgnoreCase);
											bool isAvailable = engine.IsAvailable;
											<div class="panel-card"
												 style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background-color: var(--bg-surface-elevated); cursor: @(isAvailable ? "pointer" : "not-allowed"); opacity: @(isAvailable ? "1" : "0.65"); border-color: @(isSelected ? "var(--brand-gold)" : "var(--border-subtle)");"
												 title="@(!isAvailable ? Loc["Settings_SelectDisabledTooltip"] : "")"
												 @onclick="async () => { if (isAvailable) await SelectPairingEngine(engine.Id); }">
												<div>
													<div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
														<span style="font-weight: 700; color: var(--text-primary); font-size: 13px;">@engine.DisplayName</span>
														<span class="badge @(engine.Id == "native_dutch" ? "badge-blue" : engine.Id == "bbp" ? "badge-gold" : "badge-purple")" style="font-size: 10px;">
															@(engine.Id == "native_dutch" ? Loc["Settings_EngineNativeBadge"] :
															  engine.Id == "bbp" ? Loc["Settings_EngineBbpBadge"] :
															  Loc["Settings_EngineJaVaFoBadge"])
														</span>
														@if (isSelected)
														{
															<span class="badge badge-gold">Active</span>
														}
													</div>
													<div style="font-size: 11px; color: var(--text-secondary); margin-top: 3px;">
														@(engine.Id == "native_dutch" ? Loc["Settings_EngineNativeAdvise"] :
														  engine.Id == "bbp" ? Loc["Settings_EngineBbpAdvise"] :
														  Loc["Settings_EngineJaVaFoAdvise"])
													</div>
													@if (!isAvailable)
													{
														<div style="font-size: 11px; color: var(--accent-danger); margin-top: 2px;">
															@Loc["Settings_EngineNotInstalled"]
														</div>
													}
												</div>

												<div style="display: flex; align-items: center; gap: 8px;">
													@if (isAvailable)
													{
														<span class="badge badge-green">@Loc["Settings_EngineStatusReady"]</span>
													}
													else
													{
														<span class="badge badge-gray" title="Engine executable not detected">@Loc["Settings_EngineStatusMissing"]</span>
														@if (engine.Id == "bbp" || engine.Id == "javafo")
														{
															<button type="button" class="btn-primary" style="font-size: 11px; padding: 3px 8px;"
																	disabled="@_isDownloadingEngine"
																	@onclick:stopPropagation="true"
																	@onclick="() => DownloadEngineWorkbenchAsync(engine.Id)">
																<AppIcon Name="download" Size="11" />
																<span>@(_isDownloadingEngine && _downloadingEngineId == engine.Id ? Loc["Settings_Downloading"] : Loc["Settings_DownloadInstallBtn"])</span>
															</button>
														}
													}
												</div>
											</div>
										}
									</div>
								</div>
							}

							<!-- Tiebreak Configuration Card -->
							<div class="panel-card" style="display: flex; flex-direction: column; gap: 14px;">
								<div style="display: flex; align-items: center; justify-content: space-between;">
									<div>
										<div class="panel-title" style="margin-bottom: 2px;">@Loc["Settings_Tiebreaks"]</div>
										<div style="font-size: 12px; color: var(--text-secondary);">@Loc["Settings_TiebreakDesc"]</div>
									</div>
								</div>

								<!-- Preset Selection Buttons -->
								<div style="display: flex; flex-wrap: wrap; gap: 8px;">
									<button type="button" class="btn-secondary" @onclick="() => ApplyTiebreakPreset(TiebreakPreset.FideStandardSwiss)">
										<span>@Loc["Settings_PresetSwiss"]</span>
									</button>
									<button type="button" class="btn-secondary" @onclick="() => ApplyTiebreakPreset(TiebreakPreset.RoundRobin)">
										<span>@Loc["Settings_PresetRR"]</span>
									</button>
									<button type="button" class="btn-secondary" @onclick="() => ApplyTiebreakPreset(TiebreakPreset.FideChampionship)">
										<span>@Loc["Settings_PresetChampionship"]</span>
									</button>
								</div>

								<!-- Active Priority Stack (Interactive list) -->
								<div style="margin-top: 6px;">
									<label class="form-label" style="margin-bottom: 8px;">@Loc["Settings_ActivePriority"]</label>
									@if (_tournament.TiebreakOrder.Count == 0)
									{
										<div style="padding: 12px; background: rgba(255,255,255,0.02); border: 1px dashed var(--border-color); border-radius: 6px; font-size: 12px; color: var(--text-muted); text-align: center;">
											@Loc["Tiebreak_Empty"]
										</div>
									}
									else
									{
										<div style="display: flex; flex-direction: column; gap: 6px;">
											@for (int i = 0; i < _tournament.TiebreakOrder.Count; i++)
											{
												var tb = _tournament.TiebreakOrder[i];
												int idx = i;
												<div style="display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; background: var(--bg-hover); border: 1px solid var(--border-color); border-radius: 6px; font-size: 13px;">
													<div style="display: flex; align-items: center; gap: 8px;">
														<span style="font-family: var(--font-mono); font-weight: 700; color: var(--brand-gold); width: 22px;">@(idx + 1).</span>
														<span style="font-weight: 600;">@(Loc[$"Tiebreak_{tb}"] != $"Tiebreak_{tb}" ? Loc[$"Tiebreak_{tb}"] : tb.ToFullName())</span>
														<span class="badge badge-gold" style="font-family: var(--font-mono); font-size: 11px; padding: 1px 6px;">@tb.ToShortName()</span>
													</div>
													<div style="display: flex; align-items: center; gap: 4px;">
														<button type="button" class="btn-icon" style="padding: 3px 6px; font-size: 11px;" title="@Loc["Tiebreak_MoveUp"]" disabled="@(idx == 0)" @onclick="() => MoveTiebreakUp(idx)">
															▲
														</button>
														<button type="button" class="btn-icon" style="padding: 3px 6px; font-size: 11px;" title="@Loc["Tiebreak_MoveDown"]" disabled="@(idx == _tournament.TiebreakOrder.Count - 1)" @onclick="() => MoveTiebreakDown(idx)">
															▼
														</button>
														<button type="button" class="btn-icon" style="padding: 3px 6px; font-size: 11px; color: var(--accent-danger);" title="@Loc["Tiebreak_Remove"]" @onclick="() => RemoveTiebreak(idx)">
															<AppIcon Name="x" Size="12" />
														</button>
													</div>
												</div>
											}
										</div>
									}
								</div>

								<!-- Add Criterion Section -->
								@{
									var availableToAdd = Enum.GetValues<TiebreakType>()
										.Where(t => !_tournament.TiebreakOrder.Contains(t))
										.ToList();
								}
								@if (availableToAdd.Count > 0)
								{
									<div style="display: flex; gap: 8px; align-items: center; margin-top: 4px;">
										<select class="form-select" style="flex: 1; font-size: 13px;" @bind="_selectedTiebreakToAdd">
											<option value="">-- @Loc["Tiebreak_SelectToAdd"] --</option>
											@foreach (var avail in availableToAdd)
											{
												<option value="@avail">
													@(Loc[$"Tiebreak_{avail}"] != $"Tiebreak_{avail}" ? Loc[$"Tiebreak_{avail}"] : avail.ToFullName()) (@avail.ToShortName())
												</option>
											}
										</select>
										<button type="button" class="btn-secondary" style="white-space: nowrap;" disabled="@(!_selectedTiebreakToAdd.HasValue)" @onclick="AddSelectedTiebreak">
											<AppIcon Name="plus" Size="14" />
											<span>@Loc["Tiebreak_Add"]</span>
										</button>
									</div>
								}
							</div>

							<!-- Data Exchange Card -->
							<div class="panel-card" style="display: flex; flex-direction: column; gap: 14px;">
								<div class="panel-title">@Loc["Settings_DataExchange"]</div>
								<div style="font-size: 12px; color: var(--text-secondary);">
									@Loc["Settings_DataExchangeDesc"]
								</div>

								<div style="display: flex; flex-wrap: wrap; gap: 10px;">
									<button type="button" class="btn-secondary" @onclick="DownloadTrfAsync">
										<AppIcon Name="download" Size="14" />
										<span>@Loc["Settings_ExportTrf"]</span>
									</button>
									<button type="button" class="btn-secondary" @onclick="DownloadCdeskAsync">
										<AppIcon Name="download" Size="14" />
										<span>@Loc["Settings_ExportCdesk"]</span>
									</button>
								</div>
							</div>
						</div>
					</div>

					<div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
						<button class="btn-primary" @onclick="SaveSettingsAsync">
							<AppIcon Name="save" Size="14" />
							<span>@Loc["Common_SaveChanges"]</span>
						</button>
					</div>
				</div>
			}
		</div>
	}
</div>

<!-- Modal: Add New Player -->
@if (_showAddPlayerModal)
{
	<div class="modal-overlay" @onclick="() => _showAddPlayerModal = false">
