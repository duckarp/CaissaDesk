	private int GetRatingForTournament(FidePlayerCard card)
	{
		if (_tournament == null) return card.StandardElo ?? card.RapidElo ?? card.BlitzElo ?? 0;
		return _tournament.TimeControl switch
		{
			TimeControlCategory.Rapid => card.RapidElo ?? card.StandardElo ?? card.BlitzElo ?? 0,
			TimeControlCategory.Blitz => card.BlitzElo ?? card.RapidElo ?? card.StandardElo ?? 0,
			_ => card.StandardElo ?? card.RapidElo ?? card.BlitzElo ?? 0
		};
	}

	private static string NormalizeGender(string? cardGender, string? title)
	{
		if (!string.IsNullOrWhiteSpace(cardGender) && cardGender.Trim().StartsWith("f", StringComparison.OrdinalIgnoreCase))
			return "F";
		if (!string.IsNullOrWhiteSpace(title) && title.Trim().StartsWith("W", StringComparison.OrdinalIgnoreCase))
			return "F";
		return "M";
	}

	private Task<FidePlayerCard?> SmartFideLookupAsync(string? fideId, string? fullName, string? federation)
	{
		var (last, first) = Player.SplitFullName(fullName);
		return SmartFideLookupAsync(fideId, last, first, federation);
	}

	private async Task<FidePlayerCard?> SmartFideLookupAsync(string? fideId, string? lastName, string? firstName, string? federation)
	{
		// 1. Try by FIDE ID if provided
		if (!string.IsNullOrWhiteSpace(fideId))
		{
			string cleanId = System.Text.RegularExpressions.Regex.Replace(fideId.Trim(), @"[^\d]", "");
			if (!string.IsNullOrEmpty(cleanId))
			{
				var card = await FideService.GetPlayerCardAsync(cleanId);
				if (card != null)
				{
					return card;
				}
			}
		}

		// 2. Fall back to search by Name (+ Federation)
		string cleanLast = (lastName ?? "").Trim();
		string cleanFirst = (firstName ?? "").Trim();
		var queryParts = new[] { cleanLast, cleanFirst }.Where(s => !string.IsNullOrEmpty(s));
		string query = string.Join(" ", queryParts);

		if (query.Length >= 2)
		{
			var results = await FideService.SearchPlayersByNameAsync(query);
			if ((results == null || results.Count == 0) && !string.IsNullOrWhiteSpace(cleanLast) && cleanLast.Length >= 2 && !string.IsNullOrWhiteSpace(cleanFirst))
			{
				// If full name query produced no results, try searching just the last name
				results = await FideService.SearchPlayersByNameAsync(cleanLast);
			}

			if (results != null && results.Count > 0)
			{
				var match = SelectBestFideMatch(results, cleanLast, cleanFirst, federation);
				if (match != null && !string.IsNullOrWhiteSpace(match.FideId))
				{
					var card = await FideService.GetPlayerCardAsync(match.FideId);
					if (card != null)
					{
						return card;
					}

					return new FidePlayerCard
					{
						FideId = match.FideId,
						FullName = match.FullName,
						Title = match.Title,
						FederationCode = FideCountryHelper.ToFideCode(match.Federation) ?? match.Federation,
						Federation = match.Federation,
						StandardElo = match.StandardElo,
						RapidElo = match.RapidElo,
						BlitzElo = match.BlitzElo,
						BirthYear = match.BirthYear
					};
				}
			}
		}

		return null;
	}

	private static FideSearchResult? SelectBestFideMatch(
		List<FideSearchResult> results,
		string? targetLastName,
		string? targetFirstName,
		string? targetFed)
	{
		if (results == null || results.Count == 0) return null;

		string tLast = Player.RemoveDiacritics(targetLastName ?? "").Trim().ToLowerInvariant();
		string tFirst = Player.RemoveDiacritics(targetFirstName ?? "").Trim().ToLowerInvariant();
		string? tFedCode = FideCountryHelper.ToFideCode(targetFed);

		FideSearchResult? bestResult = null;
		int bestScore = -1;

		foreach (var r in results)
		{
			var (cLastRaw, cFirstRaw) = Player.SplitFullName(r.FullName);
			string cLast = Player.RemoveDiacritics(cLastRaw).Trim().ToLowerInvariant();
			string cFirst = Player.RemoveDiacritics(cFirstRaw).Trim().ToLowerInvariant();
			string? cFedCode = FideCountryHelper.ToFideCode(r.Federation);

			int score = 0;

			// Last name scoring - candidate must match last name if provided
			if (!string.IsNullOrEmpty(tLast))
			{
				if (cLast == tLast)
				{
					score += 100;
				}
				else if (cLast.StartsWith(tLast) || tLast.StartsWith(cLast))
				{
					score += 60;
				}
				else if (cLast.Contains(tLast) || tLast.Contains(cLast))
				{
					score += 40;
				}
				else
				{
					// Fatal mismatch: candidate with different last name must NOT be picked!
					continue;
				}
			}
			else
			{
				score += 10;
			}

			// First name scoring
			if (!string.IsNullOrEmpty(tFirst))
			{
				if (cFirst == tFirst)
				{
					score += 60;
				}
				else if (cFirst.StartsWith(tFirst) || tFirst.StartsWith(cFirst))
				{
					score += 40;
				}
				else if (cFirst.Contains(tFirst) || tFirst.Contains(cFirst))
				{
					score += 25;
				}
				else
				{
					score -= 30;
				}
			}

			// Federation scoring
			if (!string.IsNullOrEmpty(tFedCode))
			{
				if (string.Equals(cFedCode, tFedCode, StringComparison.OrdinalIgnoreCase))
				{
					score += 50;
				}
				else
				{
					score -= 20;
				}
			}

			if (r.StandardElo.HasValue && r.StandardElo.Value > 0)
			{
				score += 5;
			}
			if (r.BirthYear.HasValue)
			{
				score += 1;
			}

			if (score > bestScore)
			{
				bestScore = score;
				bestResult = r;
			}
		}

		return bestScore > 0 ? bestResult : null;
	}

	private async Task LookupFidePlayerAsync()
	{
		if (string.IsNullOrWhiteSpace(_lookupFideId) && string.IsNullOrWhiteSpace(_newLastName) && string.IsNullOrWhiteSpace(_newFirstName) && string.IsNullOrWhiteSpace(_newNationalId))
		{
			_fideLookupError = Loc["Roster_FideLookupEmptyQuery"];
			return;
		}

		_isSearchingFide = true;
		_fideLookupError = null;
		_fideLookupSuccessMessage = null;

		try
		{
			// 1. FIDE Lookup
			var card = await SmartFideLookupAsync(_lookupFideId, _newLastName, _newFirstName, _newFed);
			if (card != null)
			{
				_lookupFideId = card.FideId;
				var (last, first) = Player.SplitFullName(card.FullName);

				// Preserve user-entered diacritics if base name matches
				if (!string.IsNullOrWhiteSpace(_newLastName) &&
				    string.Equals(Player.RemoveDiacritics(_newLastName).Trim(), Player.RemoveDiacritics(last).Trim(), StringComparison.OrdinalIgnoreCase))
				{
					// Retain user's accented last name (e.g. "Kamenický")
				}
				else
				{
					_newLastName = last;
				}

				if (!string.IsNullOrWhiteSpace(_newFirstName) &&
				    string.Equals(Player.RemoveDiacritics(_newFirstName).Trim(), Player.RemoveDiacritics(first).Trim(), StringComparison.OrdinalIgnoreCase))
				{
					// Retain user's accented first name
				}
				else
				{
					_newFirstName = first;
				}

				_newTitle = card.TitleAbbreviation ?? "";
				string? resolvedFed = FideCountryHelper.ToFideCode(card.FederationCode) ?? FideCountryHelper.ToFideCode(card.Federation);
				_newFed = resolvedFed ?? card.FederationCode ?? (!string.IsNullOrWhiteSpace(card.Federation) && card.Federation.Length == 3 ? card.Federation.ToUpperInvariant() : _newFed);
				_newFideRating = GetRatingForTournament(card);
				if (card.BirthYear.HasValue) _newBirthYear = card.BirthYear;
				_newGender = NormalizeGender(card.Gender, card.TitleAbbreviation);

				_fideLookupSuccessMessage = Loc["Roster_FideLookupSuccess", card.FullName];
			}

			// 2. National Database Lookup (e.g. SŠZ / chess.sk for SVK)
			string targetFed = _newFed;
			if (string.IsNullOrWhiteSpace(targetFed) && card != null)
			{
				targetFed = card.FederationCode ?? card.Federation ?? "";
			}

			try
			{
				var nationalCard = await NationalService.LookupPlayerAsync(
					_newNationalId, 
					card?.FideId ?? _lookupFideId, 
					_newLastName, 
					_newFirstName, 
					targetFed);

				if (nationalCard != null)
				{
					if (!string.IsNullOrWhiteSpace(nationalCard.NationalId))
					{
						_newNationalId = nationalCard.NationalId;
					}
					if (!string.IsNullOrWhiteSpace(nationalCard.Club))
					{
						_newClub = nationalCard.Club;
					}
					if (nationalCard.NationalRating.HasValue && nationalCard.NationalRating.Value > 0)
					{
						_newNationalRating = nationalCard.NationalRating.Value;
					}

					// If FIDE card was not found earlier, fill in basic identity from national database
					if (card == null)
					{
						if (!string.IsNullOrWhiteSpace(nationalCard.FideId))
						{
							_lookupFideId = nationalCard.FideId;
							var fetchedCard = await FideService.GetPlayerCardAsync(nationalCard.FideId);
							if (fetchedCard != null)
							{
								_newTitle = fetchedCard.TitleAbbreviation ?? "";
								_newFideRating = GetRatingForTournament(fetchedCard);
								if (fetchedCard.BirthYear.HasValue) _newBirthYear = fetchedCard.BirthYear;
								_newGender = NormalizeGender(fetchedCard.Gender, fetchedCard.TitleAbbreviation);
							}
						}

						var (nLast, nFirst) = Player.SplitFullName(nationalCard.FullName);
						if (string.IsNullOrWhiteSpace(_newLastName)) _newLastName = nLast;
						if (string.IsNullOrWhiteSpace(_newFirstName)) _newFirstName = nFirst;
						if (string.IsNullOrWhiteSpace(_newFed) && !string.IsNullOrWhiteSpace(nationalCard.Federation))
						{
							_newFed = nationalCard.Federation;
						}

						_fideLookupSuccessMessage = Loc["Roster_FideLookupSuccess", nationalCard.FullName];
					}
				}
			}
			catch (Exception ex)
			{
				Console.WriteLine($"[LookupPlayer] National lookup warning: {ex.Message}");
			}

			if (card == null && string.IsNullOrEmpty(_fideLookupSuccessMessage))
			{
				_fideLookupError = Loc["Roster_FideLookupNotFound"];
			}
		}
		catch (Exception ex)
		{
			_fideLookupError = $"Lookup failed: {ex.Message}";
		}
		finally
		{
			_isSearchingFide = false;
		}
	}

	private async Task AddPlayerAsync()
	{
		if ((string.IsNullOrWhiteSpace(_newLastName) && string.IsNullOrWhiteSpace(_newFirstName)) || _tournament == null) return;

		int nextSeed = _tournament.Players.Count + 1;
		string fedCode = FideCountryHelper.ToFideCode(_newFed) ?? (string.IsNullOrWhiteSpace(_newFed) ? "FID" : _newFed.Trim().ToUpperInvariant());
		var player = new Player
		{
			StartRank = nextSeed,
			LastName = _newLastName.Trim(),
			FirstName = _newFirstName.Trim(),
			Title = string.IsNullOrWhiteSpace(_newTitle) ? null : _newTitle.Trim(),
			Federation = fedCode,
			FideRating = _newFideRating,
			NationalRating = _newNationalRating,
			Club = string.IsNullOrWhiteSpace(_newClub) ? null : _newClub.Trim(),
			BirthYear = _newBirthYear,
			Gender = string.IsNullOrWhiteSpace(_newGender) ? "M" : _newGender,
			NationalId = string.IsNullOrWhiteSpace(_newNationalId) ? null : _newNationalId.Trim(),
			FideId = string.IsNullOrWhiteSpace(_lookupFideId) ? null : _lookupFideId.Trim()
		};

		_tournament.Players.Add(player);
		await TournamentRepo.SaveAsync(_tournament);
		_showAddPlayerModal = false;
		Tab.NotifyChanged();
	}

	private void OpenEditPlayerModal(Player player)
	{
		_editingPlayer = player;
		_editLastName = player.LastName;
		_editFirstName = player.FirstName;
		if (string.IsNullOrWhiteSpace(_editLastName) && string.IsNullOrWhiteSpace(_editFirstName) && !string.IsNullOrWhiteSpace(player.FullName))
		{
			var (last, first) = Player.SplitFullName(player.FullName);
			_editLastName = last;
			_editFirstName = first;
		}
		_editTitle = player.Title ?? "";
		_editFed = player.Federation ?? "FID";
		_editFideRating = player.FideRating;
		_editNationalRating = player.NationalRating;
		_editClub = player.Club ?? "";
		_editBirthYear = player.BirthYear;
		_editGender = string.IsNullOrEmpty(player.Gender) ? "M" : player.Gender;
		_editNationalId = player.NationalId ?? "";
		_editFideId = player.FideId ?? "";
		_editStatus = player.Status;
		_editFideMessage = null;
		_editFideIsError = false;
		_showEditPlayerModal = true;
	}

	private async Task LookupFideForEditAsync()
