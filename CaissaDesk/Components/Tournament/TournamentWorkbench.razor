	private async Task GeneratePairingsAsync()
	{
		if (_tournament == null || _tournament.Players.Count < 2) return;
		_pairingErrorMessage = null;

		// Pair against an empty history; the live rounds are only replaced once pairing succeeded
		List<Round> newRounds;
		if (_tournament.System == TournamentSystem.RoundRobin)
		{
			try
			{
				newRounds = WithRoundHistory([], () => new BergerPairingEngine().GenerateAllRounds(_tournament));
			}
			catch (Exception ex)
			{
				_pairingErrorMessage = ex.Message;
				return;
			}

			if (newRounds.Count == 0)
			{
				_pairingErrorMessage = "Failed to generate round-robin pairings.";
				return;
			}
		}
		else
		{
			var result = GenerateRoundWithHistory([], 1);
			if (!result.Success)
			{
				_pairingErrorMessage = result.ErrorMessage ?? "Failed to generate round pairings.";
				return;
			}
			newRounds = [new Round { RoundNumber = 1, Pairings = result.Pairings }];
		}

		_tournament.Rounds = newRounds;
		if (_tournament.System == TournamentSystem.RoundRobin)
		{
			_tournament.TotalRounds = newRounds.Count;
		}
		_activeRoundNumber = 1;

		await TournamentRepo.SaveAsync(_tournament);
		Tab.NotifyChanged();
	}

	/// <summary>
	/// Runs <paramref name="generate"/> while the tournament temporarily exposes <paramref name="history"/>
	/// as its rounds, so engines can pair against a hypothetical history without the live rounds being lost.
	/// </summary>
	private T WithRoundHistory<T>(List<Round> history, Func<T> generate)
	{
		var liveRounds = _tournament!.Rounds;
		_tournament.Rounds = history;
		try
		{
			return generate();
		}
		finally
		{
			_tournament.Rounds = liveRounds;
		}
	}

	private PairingResult GenerateRoundWithHistory(List<Round> history, int roundNumber)
	{
		try
		{
			var engine = EngineRegistry.GetEngine(_tournament!.PairingEngineId);
			return WithRoundHistory(history, () => engine.GenerateRoundPairings(_tournament, roundNumber));
		}
		catch (Exception ex)
		{
			return PairingResult.Fail(ex.Message);
		}
	}

	private string? _pairingErrorMessage;

	private async Task GenerateNextRoundAsync()
	{
		if (_tournament == null) return;
		_pairingErrorMessage = null;
		int nextRoundNumber = _tournament.Rounds.Count + 1;
		if (nextRoundNumber > _tournament.TotalRounds) return;

		var latestRound = _tournament.Rounds.OrderBy(r => r.RoundNumber).LastOrDefault();
		if (latestRound != null)
		{
			var pending = latestRound.Pairings.Where(p => p.Result == MatchResult.NotPlayed).ToList();
			if (pending.Count > 0)
			{
				_unfinishedRoundNumber = latestRound.RoundNumber;
				_unfinishedPairings = pending;
				_showUnfinishedGamesModal = true;
				return;
			}
		}

		var result = GenerateRoundWithHistory(_tournament.Rounds, nextRoundNumber);
		if (result.Success)
		{
			_tournament.Rounds.Add(new Round { RoundNumber = nextRoundNumber, Pairings = result.Pairings });
			_activeRoundNumber = nextRoundNumber;
			await TournamentRepo.SaveAsync(_tournament);
			Tab.NotifyChanged();
		}
		else
		{
			_pairingErrorMessage = result.ErrorMessage ?? "Failed to generate round pairings.";
		}
	}

