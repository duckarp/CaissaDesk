		{
			_editFideMessage = Loc["Roster_FideLookupEmptyQuery"];
			_editFideIsError = true;
			return;
		}

		_isEditingFideSearching = true;
		_editFideMessage = null;
		_editFideIsError = false;

		try
		{
			// 1. FIDE Lookup
			var card = await SmartFideLookupAsync(_editFideId, _editLastName, _editFirstName, _editFed);
			if (card != null)
			{
				_editFideId = card.FideId;
