	{
		if (_tournament == null) return;
		_settingsErrorMessage = null;
		_settingsSuccessMessage = null;

		switch (Details.TryApplyTo(_tournament))
		{
			case TournamentDetailsValidation.NameRequired:
				_settingsErrorMessage = Loc["Tournament_Name"] + " is required.";
				return;
			case TournamentDetailsValidation.TooFewRounds:
				_settingsErrorMessage = Loc["Tournament_MinRoundsError", _tournament.MinAllowedRounds];
