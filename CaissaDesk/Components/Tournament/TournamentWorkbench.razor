	private async Task ResetRoundAsync(int roundNumber)
	{
		if (_tournament == null) return;
		_pairingErrorMessage = null;

		if (_tournament.System == TournamentSystem.RoundRobin)
		{
			var targetRound = _tournament.Rounds.FirstOrDefault(r => r.RoundNumber == roundNumber);
			if (targetRound != null)
			{
				foreach (var p in targetRound.Pairings)
				{
					p.Result = MatchResult.NotPlayed;
					p.IsManualOverride = false;
				}
			}
		}
		else
		{
			// Pair against the history without this round; keep the existing round if the engine fails
			var history = _tournament.Rounds.Where(r => r.RoundNumber != roundNumber).ToList();
			var result = GenerateRoundWithHistory(history, roundNumber);
			if (!result.Success)
			{
				_pairingErrorMessage = result.ErrorMessage ?? $"Failed to regenerate pairings for Round {roundNumber}.";
				return;
			}

			_tournament.Rounds.RemoveAll(r => r.RoundNumber == roundNumber);
			_tournament.Rounds.Add(new Round { RoundNumber = roundNumber, Pairings = result.Pairings });
			_activeRoundNumber = roundNumber;
		}

		await TournamentRepo.SaveAsync(_tournament);
		Tab.NotifyChanged();
	}

