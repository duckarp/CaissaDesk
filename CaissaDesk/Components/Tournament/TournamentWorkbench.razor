					<div class="form-group">
						<label class="form-label">@Loc["Roster_FideElo"]</label>
						<input type="number" class="form-input" @bind="_newFideRating" min="0" max="3000" />
					</div>

					<div class="form-group">
						<label class="form-label">@Loc["Common_NationalRating"]</label>
						<input type="number" class="form-input" @bind="_newNationalRating" min="0" max="3000" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label">@Loc["Common_Club"]</label>
						<input type="text" class="form-input" @bind="_newClub" placeholder="e.g. ŠK Slovan Bratislava" />
					</div>

					<div class="form-group">
						<label class="form-label">@Loc["Roster_BirthYear"]</label>
						<input type="number" class="form-input" @bind="_newBirthYear" min="1900" max="2026" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
					<div class="form-group">
						<label class="form-label">@Loc["Common_Gender"]</label>
						<select class="form-select" @bind="_newGender">
							<option value="M">@Loc["Common_Male"]</option>
							<option value="F">@Loc["Common_Female"]</option>
						</select>
					</div>

					<div class="form-group">
						<label class="form-label">@Loc["Common_NationalId"]</label>
						<input type="text" class="form-input" @bind="_newNationalId" placeholder="e.g. 12345" />
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<button class="btn-secondary" @onclick="() => _showAddPlayerModal = false">@Loc["Common_Cancel"]</button>
				<button class="btn-primary" @onclick="AddPlayerAsync" disabled="@(string.IsNullOrWhiteSpace(_newLastName) && string.IsNullOrWhiteSpace(_newFirstName))">
					<AppIcon Name="plus" Size="14" />
					<span>@Loc["Roster_AddPlayerBtn"]</span>
				</button>
			</div>
		</div>
	</div>
}

