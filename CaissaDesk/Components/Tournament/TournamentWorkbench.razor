				_editFed = resolvedFed ?? card.FederationCode ?? (!string.IsNullOrWhiteSpace(card.Federation) && card.Federation.Length == 3 ? card.Federation.ToUpperInvariant() : _editFed);
				_editFideRating = GetRatingForTournament(card);
				if (card.BirthYear.HasValue) _editBirthYear = card.BirthYear;
				_editGender = NormalizeGender(card.Gender, card.TitleAbbreviation);

				_editFideMessage = Loc["Roster_FideLookupSuccess", card.FullName];
				_editFideIsError = false;
			}

			// 2. National Database Lookup (e.g. SŠZ / chess.sk for SVK)
			string targetFed = _editFed;
			if (string.IsNullOrWhiteSpace(targetFed) && card != null)
			{
				targetFed = card.FederationCode ?? card.Federation ?? "";
			}

			try
