	private async Task SyncAllPlayersFromFideAsync()
	{
		if (_tournament == null || _tournament.Players.Count == 0 || _isSyncingAllFide) return;

		_isSyncingAllFide = true;
		_syncProgressCurrent = 0;
		_syncProgressTotal = _tournament.Players.Count;
		_syncResultMessage = null;
		int updatedCount = 0;

		try
		{
			foreach (var player in _tournament.Players)
			{
				_syncProgressCurrent++;
				StateHasChanged();

				try
				{
					var card = await SmartFideLookupAsync(player.FideId, player.LastName, player.FirstName, player.Federation);
					if (card != null)
					{
						if (string.IsNullOrWhiteSpace(player.FideId) && !string.IsNullOrWhiteSpace(card.FideId))
						{
							player.FideId = card.FideId;
						}

						if (!string.IsNullOrWhiteSpace(card.TitleAbbreviation))
						{
							player.Title = card.TitleAbbreviation;
						}

						string? fedCode = FideCountryHelper.ToFideCode(card.FederationCode) ?? FideCountryHelper.ToFideCode(card.Federation);
						if (!string.IsNullOrWhiteSpace(fedCode))
						{
							player.Federation = fedCode;
						}

						int rating = GetRatingForTournament(card);
						if (rating > 0)
						{
							player.FideRating = rating;
						}

						if (card.BirthYear.HasValue)
						{
							player.BirthYear = card.BirthYear;
						}

						player.Gender = NormalizeGender(card.Gender, card.TitleAbbreviation);
						updatedCount++;
					}

					// Also sync national details (club, national rating, national ID)
					try
					{
						var nationalCard = await NationalService.LookupPlayerAsync(
							player.NationalId,
							card?.FideId ?? player.FideId,
							player.LastName,
							player.FirstName,
							player.Federation);

						if (nationalCard != null)
						{
							if (string.IsNullOrWhiteSpace(player.NationalId) && !string.IsNullOrWhiteSpace(nationalCard.NationalId))
							{
								player.NationalId = nationalCard.NationalId;
							}
							if (string.IsNullOrWhiteSpace(player.Club) && !string.IsNullOrWhiteSpace(nationalCard.Club))
							{
								player.Club = nationalCard.Club;
							}
							if (nationalCard.NationalRating.HasValue && nationalCard.NationalRating.Value > 0)
							{
								player.NationalRating = nationalCard.NationalRating.Value;
							}
						}
					}
					catch (Exception ex)
					{
						Console.WriteLine($"[SyncAllPlayers] National sync warning for {player.FullName}: {ex.Message}");
					}

					await Task.Delay(80);
				}
				catch (Exception ex)
				{
					Console.WriteLine($"[SyncAllPlayersFromFide] Error for {player.FullName}: {ex.Message}");
				}
			}

			await TournamentRepo.SaveAsync(_tournament);
			_syncResultMessage = Loc["Roster_SyncSuccess", updatedCount, _tournament.Players.Count];
			Tab.NotifyChanged();
		}
		catch (Exception ex)
		{
			_syncResultMessage = $"Sync failed: {ex.Message}";
		}
		finally
		{
			_isSyncingAllFide = false;
			StateHasChanged();
		}
	}

