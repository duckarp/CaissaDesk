	// Settings form edits a draft; the live tournament only changes on a validated save.
	// The draft is rebuilt whenever the tab's tournament instance is replaced.
	private TournamentDetailsDraft? _detailsDraft;
	private Tournament? _detailsDraftSource;

	private TournamentDetailsDraft Details
	{
		get
		{
			if (_detailsDraft == null || !ReferenceEquals(_detailsDraftSource, _tournament))
			{
				_detailsDraft = TournamentDetailsDraft.From(_tournament!);
				_detailsDraftSource = _tournament;
			}
			return _detailsDraft;
		}
	}

