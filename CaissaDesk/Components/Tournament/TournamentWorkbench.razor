@namespace CaissaDesk.Components.Tournament
@using Caissa.Shared.Models
@using CaissaDesk.Core
@using CaissaDesk.Core.Notifications
@using CaissaDesk.Data
@using CaissaDesk.Localization
@inject ITournamentRepository TournamentRepo
@inject ITiebreakService TiebreakService
@inject ILocalizationService Loc
@inject WorkspaceState Workspace
@inject ICaissaResultsSyncService CaissaResultsSync
@inject IExternalLinkService ExternalLinks
@inject INotificationService Notifications
@inject ILogger<TournamentWorkbench> Logger
@implements IDisposable

@* Thin coordinator: loads the tournament, renders the header and hosts the sub-views, which share WorkbenchState *@
<div class="tournament-workbench" style="display: flex; flex-direction: column; height: 100%; width: 100%; overflow: hidden; background-color: var(--bg-canvas);">
	@if (_isLoading)
	{
		<div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
			<div class="app-splash-spinner" style="margin: 0 auto 12px;"></div>
			<div>@Loc["Workbench_Loading"]</div>
		</div>
	}
	else if (_tournament == null)
	{
		<div class="panel-card" style="text-align: center; padding: 48px 24px; max-width: 480px; margin: 40px auto;">
			<div style="color: var(--accent-danger-hover); margin-bottom: 12px;"><AppIcon Name="warning" Size="32" /></div>
			<div style="font-weight: 700; font-size: 16px; color: var(--text-primary); margin-bottom: 8px;">@Loc["Workbench_NotFoundTitle"]</div>
			<div style="color: var(--text-secondary); font-size: 13px; margin-bottom: 20px;">@Loc["Workbench_NotFoundDesc"]</div>
			<button class="btn-primary" @onclick="() => Workspace.CloseTab(Tab.Id)">
				<span>@Loc["Workbench_CloseTab"]</span>
			</button>
		</div>
	}
	else
	{
		<!-- Workbench Top Control Bar -->
		<header style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-subtle); padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; flex-wrap: wrap; gap: 12px;">
			<div style="display: flex; align-items: center; gap: 14px;">
				<div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(250, 204, 21, 0.15); color: var(--brand-gold); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
					<AppIcon Name="trophy" Size="20" />
				</div>
				<div>
					<div style="display: flex; align-items: center; gap: 10px;">
						<h2 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin: 0; line-height: 1.2;">
							@_tournament.Name
						</h2>
						@if (_tournament.FideRated)
						{
							<span class="badge badge-gold" title="FIDE Rated Tournament">FIDE</span>
						}
						@if (_tournament.IsFinished)
						{
							<span class="badge badge-gray" style="font-size: 11px; display: inline-flex; align-items: center; gap: 4px;">
								<AppIcon Name="archive" Size="11" />
								<span>@Loc["Workbench_FinishedBadge"]</span>
							</span>
						}
					</div>
					<div style="display: flex; align-items: center; gap: 12px; margin-top: 3px; font-size: 12px; color: var(--text-secondary);">
						<span>@(_tournament.System == TournamentSystem.SwissDutch ? Loc["Tournament_SwissDutch"] : Loc["Tournament_RoundRobin"])</span>
						<span>•</span>
						<span>@_tournament.TimeControl (@_tournament.TimeControlDetails)</span>
						<span>•</span>
						<span>@Loc["Workbench_TotalRounds", _tournament.TotalRounds]</span>
						@if (!string.IsNullOrEmpty(_tournament.ChiefArbiter))
						{
							<span>•</span>
							<span>@Loc["Workbench_ArbiterLabel", _tournament.ChiefArbiter]</span>
						}
					</div>
				</div>
			</div>

			<!-- Sub-view Navigation Pills -->
			<div style="display: flex; align-items: center; gap: 10px;">
				<div style="display: flex; align-items: center; background-color: var(--bg-surface-elevated); padding: 3px; border-radius: 6px; border: 1px solid var(--border-subtle);">
					<button class="@GetNavButtonClass(TournamentView.Roster)" @onclick="() => SetView(TournamentView.Roster)">
						<AppIcon Name="users" Size="13" />
						<span>@Loc["Workbench_PlayersTab", _tournament.Players.Count]</span>
					</button>
					<button class="@GetNavButtonClass(TournamentView.Pairings)" @onclick="() => SetView(TournamentView.Pairings)">
						<AppIcon Name="pairings" Size="13" />
						<span>@Loc["Workbench_RoundsTab", _tournament.Rounds.Count]</span>
					</button>
					<button class="@GetNavButtonClass(TournamentView.Standings)" @onclick="() => SetView(TournamentView.Standings)">
						<AppIcon Name="medal" Size="13" />
						<span>@Loc["Nav_Standings"]</span>
					</button>
					<button class="@GetNavButtonClass(TournamentView.Settings)" @onclick="() => SetView(TournamentView.Settings)">
						<AppIcon Name="settings" Size="13" />
						<span>@Loc["Nav_Settings"]</span>
					</button>
				</div>

				<button class="btn-secondary" style="height: 34px; padding: 0 12px; gap: 6px;" title="@Loc["Workbench_PrintReports"]" @onclick="() => _showPrintModal = true">
					<AppIcon Name="printer" Size="14" />
					<span>@Loc["Workbench_PrintReports"]</span>
				</button>

				@{
					bool isSyncEnabled = CaissaResultsSync.IsSyncConfigured;
				}
				<button class="btn-secondary" 
						style="height: 34px; padding: 0 12px; gap: 6px; @(isSyncEnabled ? "border-color: rgba(16, 185, 129, 0.4); color: #34d399;" : "opacity: 0.6; color: var(--text-muted);")" 
						title="@(isSyncEnabled ? "Publish to CaissaResults Web Portal" : "Syncing disabled: Configure API key in Settings")" 
						@onclick="PublishToCaissaResultsAsync" 
						disabled="@(_isSyncingToWeb || !isSyncEnabled)">
					@if (_isSyncingToWeb)
					{
						<span class="app-splash-spinner" style="width: 12px; height: 12px; margin: 0;"></span>
						<span>Syncing...</span>
					}
					else
					{
						<AppIcon Name="cloud" Size="14" />
						<span>Publish to Web</span>
					}
				</button>

				@if (_hasPublishedToWeb)
				{
					<button class="btn-secondary" style="height: 34px; padding: 0 10px; gap: 6px; color: var(--accent-info-hover);" title="Open in CaissaResults Web Portal" @onclick="OpenWebPortal">
						<AppIcon Name="globe" Size="14" />
						<span>View Web</span>
					</button>
				}
			</div>
		</header>

		@if (!string.IsNullOrEmpty(_webSyncStatusMessage))
		{
			<div style="margin: 12px 20px 0 20px; padding: 8px 14px; border-radius: 6px; font-size: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; @(_hasPublishedToWeb ? "background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;" : "background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;")">
				<div style="display: flex; align-items: center; gap: 8px;">
					<AppIcon Name="@(_hasPublishedToWeb ? "check" : "alert")" Size="14" />
					<span>@_webSyncStatusMessage</span>
				</div>
				<button style="background: none; border: none; cursor: pointer; color: inherit; opacity: 0.7; padding: 2px;" @onclick="() => _webSyncStatusMessage = null">✕</button>
			</div>
		}

		<!-- Sub-view Content Body -->
		<div style="flex: 1; overflow-y: auto; padding: 20px;">
			@switch (Tab.CurrentView)
			{
				case TournamentView.Roster:
					<RosterView State="_state" />
					break;
				case TournamentView.Pairings:
					<PairingsView State="_state" />
					break;
				case TournamentView.Standings:
					<StandingsView State="_state" />
					break;
				case TournamentView.Settings:
					<TournamentSettingsView State="_state" />
					break;
			}
		</div>
	}
</div>

<!-- Modal: Official Print Sheets & TRF Export -->
<PrintSheetsModal IsOpen="_showPrintModal"
				  Tournament="_tournament"
				  OnClose="() => _showPrintModal = false" />

<ConfirmDialog State="_state.Confirm" />

@code {
	[Parameter, EditorRequired] public TournamentTab Tab { get; set; } = default!;

	private WorkbenchState _state = default!;

	// Always read through the tab: the dashboard edit modal and WorkspaceState.OpenTournament replace
	// Tab.Tournament with a fresh instance, and a cached copy here would overwrite those edits on next save.
	private Tournament? _tournament => Tab.Tournament;

	private bool _isLoading = true;
	private bool _showPrintModal;

	protected override async Task OnInitializedAsync()
	{
		_state = new WorkbenchState(Tab, TiebreakService, SaveTournamentAsync);
		_state.Changed += HandleStateChanged;
		Tab.OnTabChanged += StateHasChanged;
		Loc.OnLanguageChanged += StateHasChanged;

		_isLoading = true;
		try
		{
			if (Tab.Tournament == null)
			{
				Tab.Tournament = await TournamentRepo.GetByIdAsync(Tab.TournamentId);
			}

			if (_tournament != null && _tournament.Rounds.Count > 0)
			{
				_state.ActiveRoundNumber = _tournament.Rounds.First().RoundNumber;
			}
		}
		catch (Exception ex)
		{
			// Rendered as the "tournament not found" panel
			Logger.LogError(ex, "Loading tournament {TournamentId} failed.", Tab.TournamentId);
			Notifications.ShowError(Loc["Toast_LoadFailed", ex.Message]);
		}
		finally
		{
			_isLoading = false;
		}
	}

	// Sub-views change shared state after awaits (FIDE sync progress, pairing results): re-render them all
	private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

	/// <summary>Persists the tournament for every sub-view; failures are logged and shown as a toast.</summary>
	private async Task<bool> SaveTournamentAsync(Tournament tournament)
	{
		try
		{
			await TournamentRepo.SaveAsync(tournament);
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Saving tournament {TournamentId} failed.", tournament.Id);
			Notifications.ShowError(Loc["Toast_SaveFailed", ex.Message]);
			return false;
		}

		Tab.NotifyChanged();
		return true;
	}

	private void SetView(TournamentView view)
	{
		// Leaving (or re-entering) settings drops unsaved edits so the form never shows stale values
		_state.DiscardDetailsDraft();
		Tab.SetView(view);
	}

	private string GetNavButtonClass(TournamentView view) =>
		Tab.CurrentView == view
			? "workspace-tab tab-active"
			: "workspace-tab";

	// ---------------------------------------------------------------- CaissaResults web portal

	private bool _isSyncingToWeb;
	private bool _hasPublishedToWeb;
	private string? _webSyncStatusMessage;

	private async Task PublishToCaissaResultsAsync()
	{
		if (_tournament == null) return;
		if (!CaissaResultsSync.IsSyncConfigured)
		{
			_webSyncStatusMessage = "Upload disabled: CaissaResults API Key is not configured. Please enter the API key in Settings.";
			StateHasChanged();
			return;
		}

		_isSyncingToWeb = true;
		StateHasChanged();

		try
		{
			var result = await CaissaResultsSync.PublishTournamentAsync(_tournament);
			if (result.Success)
			{
				_hasPublishedToWeb = true;
				_webSyncStatusMessage = "Successfully published to CaissaResults!";
				await TournamentRepo.SaveAsync(_tournament);
			}
			else
			{
				_webSyncStatusMessage = result.Message;
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Publishing tournament {TournamentId} to CaissaResults failed.", _tournament.Id);
			_webSyncStatusMessage = $"Sync error: {ex.Message}";
		}
		finally
		{
			_isSyncingToWeb = false;
			StateHasChanged();
		}
	}

	private void OpenWebPortal()
	{
		if (_tournament == null) return;
		var url = CaissaResultsSync.GetPortalUrl(_tournament.Id);
		// Photino ignores window.open in some setups: hand the link to the OS browser instead
		if (!ExternalLinks.TryOpen(url))
		{
			Notifications.ShowError(Loc["Toast_OpenLinkFailed", url]);
		}
	}

	public void Dispose()
	{
		if (_state != null)
		{
			_state.Changed -= HandleStateChanged;
			// Abandon any pairing still running for this workbench (kills an external engine process)
			_state.Dispose();
		}
		Tab.OnTabChanged -= StateHasChanged;
		Loc.OnLanguageChanged -= StateHasChanged;
	}
}
