@namespace CaissaDesk.Components.Tournament
@using Caissa.Shared.Models
@using CaissaDesk.Core.Roster
@using CaissaDesk.Data
@using CaissaDesk.Localization
@inject IPlayerLookupService PlayerLookup
@inject ILocalizationService Loc

@* Register (Player == null) or edit player form, with the FIDE / national database auto-lookup *@
@if (IsOpen && _form != null)
{
	<ModalDialog LabelledBy="@_titleId" OnCancel="Close" Style="max-width: 620px;">
		<div class="modal-header">
			<div class="modal-title" id="@_titleId">
				@if (IsEdit)
				{
					<span style="color: var(--brand-gold);"><AppIcon Name="edit" Size="18" /></span>
					<span>@Loc["Roster_EditPlayer"] - @Player!.FullName</span>
				}
				else
				{
					<span style="color: var(--brand-gold);"><AppIcon Name="users" Size="18" /></span>
					<span>@Loc["Roster_RegisterPlayer"]</span>
				}
			</div>
			<button class="modal-close-btn" @onclick="Close" type="button" title="@Loc["Common_Close"]" aria-label="@Loc["Common_Close"]">
				<AppIcon Name="x" Size="15" />
			</button>
		</div>

		<div class="modal-body">
			<!-- Instant FIDE ID lookup tool -->
			<div class="panel-card" style="margin-bottom: 16px; background-color: var(--bg-surface-elevated);">
				<label class="form-label" for="@($"{_titleId}-lookup")" style="display: flex; align-items: center; justify-content: space-between;">
					<span>@Loc["Roster_FideAutoLookup"]</span>
					@if (_isSearching)
					{
						<span style="color: var(--brand-gold); font-size: 11px;">@Loc["Roster_SearchingFide"]</span>
					}
				</label>
				<div style="display: flex; gap: 8px;">
					<input type="text" class="form-input" id="@($"{_titleId}-lookup")" style="flex: 1;" placeholder="@Loc["Roster_FideLookupPrompt"]" @bind="_form.FideId" @bind:event="oninput" />
					<button class="btn-secondary" @onclick="LookupAsync" disabled="@(_isSearching || !_form.CanLookup)">
						<AppIcon Name="search" Size="13" />
						<span>@Loc["Roster_Fetch"]</span>
					</button>
				</div>
				@if (!string.IsNullOrEmpty(_lookupMessage))
				{
					<div role="status" style="color: @(_lookupIsError ? "var(--accent-danger-hover)" : "var(--accent-success)"); font-size: 11px; margin-top: 6px;">
						@_lookupMessage
					</div>
				}
			</div>

			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-last")">@Loc["Common_LastName"] <span style="color: #ef4444;" aria-hidden="true">*</span></label>
					<input type="text" class="form-input" id="@($"{_titleId}-last")" @bind="_form.LastName" placeholder="@Loc["Player_PlaceholderLastName"]" aria-required="true" />
				</div>
				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-first")">@Loc["Common_FirstName"]</label>
					<input type="text" class="form-input" id="@($"{_titleId}-first")" @bind="_form.FirstName" placeholder="@Loc["Player_PlaceholderFirstName"]" />
				</div>
			</div>

			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-title")">@Loc["Common_Title"]</label>
					<select class="form-select" id="@($"{_titleId}-title")" @bind="_form.Title">
						<option value="">@Loc["Common_None"]</option>
						@foreach (var titleCode in LocalizationExtensions.TitleCodes)
						{
							<option value="@titleCode">@Loc.TitleOptionLabel(titleCode)</option>
						}
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-fed")">@Loc["Common_Federation"]</label>
					<input type="text" class="form-input" id="@($"{_titleId}-fed")" @bind="_form.Federation" placeholder="@Loc["Player_PlaceholderFederation"]" maxlength="3" />
				</div>
			</div>

			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-elo")">@Loc["Roster_FideElo"]</label>
					<input type="number" class="form-input" id="@($"{_titleId}-elo")" @bind="_form.FideRating" min="0" max="3000" />
				</div>

				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-nat-elo")">@Loc["Common_NationalRating"]</label>
					<input type="number" class="form-input" id="@($"{_titleId}-nat-elo")" @bind="_form.NationalRating" min="0" max="3000" />
				</div>
			</div>

			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-club")">@Loc["Common_Club"]</label>
					<input type="text" class="form-input" id="@($"{_titleId}-club")" @bind="_form.Club" placeholder="@Loc["Player_PlaceholderClub"]" />
				</div>

				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-birth")">@Loc["Roster_BirthYear"]</label>
					<input type="number" class="form-input" id="@($"{_titleId}-birth")" @bind="_form.BirthYear" min="1900" max="2026" />
				</div>
			</div>

			<div style="display: grid; grid-template-columns: @(IsEdit ? "1fr 1fr 1fr" : "1fr 1fr"); gap: 12px;">
				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-gender")">@Loc["Common_Gender"]</label>
					<select class="form-select" id="@($"{_titleId}-gender")" @bind="_form.Gender">
						<option value="M">@Loc["Common_Male"]</option>
						<option value="F">@Loc["Common_Female"]</option>
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="@($"{_titleId}-nat-id")">@Loc["Common_NationalId"]</label>
					<input type="text" class="form-input" id="@($"{_titleId}-nat-id")" @bind="_form.NationalId" placeholder="@Loc["Player_PlaceholderNationalId"]" />
				</div>

				@if (IsEdit)
				{
					<div class="form-group">
						<label class="form-label" for="@($"{_titleId}-status")">@Loc["Common_Status"]</label>
						<select class="form-select" id="@($"{_titleId}-status")" @bind="_form.Status">
							<option value="@PlayerStatus.Active">@Loc.PlayerStatusLabel(PlayerStatus.Active)</option>
							<option value="@PlayerStatus.Paused">@Loc.PlayerStatusLabel(PlayerStatus.Paused)</option>
							<option value="@PlayerStatus.Withdrawn">@Loc.PlayerStatusLabel(PlayerStatus.Withdrawn)</option>
						</select>
					</div>
				}
			</div>
		</div>

		<div class="modal-footer">
			<button class="btn-secondary" @onclick="Close">@Loc["Common_Cancel"]</button>
			<button class="btn-primary" @onclick="SaveAsync" disabled="@(!_form.HasName)">
				@if (IsEdit)
				{
					<AppIcon Name="save" Size="14" />
					<span>@Loc["Roster_EditPlayerBtn"]</span>
				}
				else
				{
					<AppIcon Name="plus" Size="14" />
					<span>@Loc["Roster_AddPlayerBtn"]</span>
				}
			</button>
		</div>
	</ModalDialog>
}

@code {
	private readonly string _titleId = DomIds.Next("player-form-title");
	[Parameter] public bool IsOpen { get; set; }

	/// <summary>The player being edited, or null to register a new one.</summary>
	[Parameter] public Player? Player { get; set; }

	/// <summary>Supplies the default federation and the time control used to pick the FIDE rating list.</summary>
	[Parameter] public Tournament? Tournament { get; set; }

	[Parameter] public EventCallback OnClose { get; set; }

	/// <summary>The validated form; the parent applies it, saves and closes the modal on success.</summary>
	[Parameter] public EventCallback<PlayerFormModel> OnSave { get; set; }

	private PlayerFormModel? _form;
	private bool _wasOpen;
	private Player? _loadedPlayer;
	private bool _isSearching;
	private string? _lookupMessage;
	private bool _lookupIsError;

	private bool IsEdit => Player != null;

	protected override void OnParametersSet()
	{
		// Reset the form only when the modal opens or targets another player, never on a plain re-render
		if (IsOpen && (!_wasOpen || !ReferenceEquals(Player, _loadedPlayer)))
		{
			_form = Player != null ? PlayerFormModel.FromPlayer(Player) : PlayerFormModel.ForNewPlayer(Tournament);
			_lookupMessage = null;
			_lookupIsError = false;
		}

		_wasOpen = IsOpen;
		_loadedPlayer = IsOpen ? Player : null;
	}

	private async Task LookupAsync()
	{
		if (_form == null) return;
		var form = _form;

		if (!form.HasLookupQuery)
		{
			_lookupMessage = Loc["Roster_FideLookupEmptyQuery"];
			_lookupIsError = true;
			return;
		}

		_isSearching = true;
		_lookupMessage = null;
		_lookupIsError = false;

		try
		{
			var outcome = await PlayerLookup.LookupIntoFormAsync(form, Tournament?.TimeControl);
			(_lookupMessage, _lookupIsError) = outcome.Status switch
			{
				PlayerLookupStatus.Found => (Loc["Roster_FideLookupSuccess", outcome.MatchedName ?? ""], false),
				PlayerLookupStatus.NotFound => (Loc["Roster_FideLookupNotFound"], true),
				_ => (Loc["Roster_FideLookupFailed", outcome.FailureMessage ?? Loc["Settings_UnknownError"]], true)
			};
		}
		finally
		{
			_isSearching = false;
		}
	}

	private async Task SaveAsync()
	{
		if (_form == null || !_form.HasName) return;
		await OnSave.InvokeAsync(_form);
	}

	private async Task Close()
	{
		await OnClose.InvokeAsync();
	}
}
