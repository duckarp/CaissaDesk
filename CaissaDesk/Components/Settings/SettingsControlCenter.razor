	/// <summary>Localized reason why signed sync requests to <paramref name="url"/> would be refused, or null when allowed.</summary>
	private string? GetTransportStatusMessage(string url, bool allowPrivateNetworkHttp)
	{
		if (CaissaResultsSyncService.GetInsecureTransportError(url, allowPrivateNetworkHttp) == null) return null;
		if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
		{
			return Loc["Settings_SyncTestInvalidUrl", url];
		}
		return allowPrivateNetworkHttp
			? Loc["Settings_SyncTestInsecurePublic", uri.Host]
			: Loc["Settings_SyncTestInsecure", uri.Host];
	}
