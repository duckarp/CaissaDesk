								<label class="form-label" for="@($"{_uid}-f14")" style="display: block; margin-bottom: 6px; font-weight: 500;">@Loc["Settings_SyncServerUrl"]</label>
								<input id="@($"{_uid}-f14")" type="text" class="form-input" style="width: 100%; max-width: 500px;" @bind="_cloudSyncModel.CaissaResultsUrl" placeholder="http://localhost:5200" />
								<div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">@Loc["Settings_SyncServerUrlHint"]</div>
							</div>

							<div>
								<label class="form-label" for="@($"{_uid}-f15")" style="display: block; margin-bottom: 6px; font-weight: 500;">
									@Loc["Settings_SyncApiKey"] <span style="color: #ef4444; font-weight: 700;" aria-hidden="true">*</span>
								</label>
								<input id="@($"{_uid}-f15")" type="password" class="form-input" style="width: 100%; max-width: 500px;" @bind="_cloudSyncModel.CaissaResultsApiKey" placeholder="@Loc["Settings_SyncApiKeyPlaceholder"]" />
								<div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
									@Loc["Settings_SyncApiKeyHint"]
								</div>
							</div>

							<div style="display: flex; align-items: center; gap: 10px; margin-top: 4px;">
								<input type="checkbox" id="@($"{_uid}-autoSyncCheck")" @bind="_cloudSyncModel.AutoSyncOnResultChange" style="cursor: pointer;" />
								<label for="@($"{_uid}-autoSyncCheck")" style="font-size: 13px; color: var(--text-primary); cursor: pointer;">
									@Loc["Settings_SyncAutoSync"]
								</label>
							</div>

							<div style="display: flex; flex-direction: column; gap: 6px;">
								<div style="display: flex; align-items: center; gap: 10px;">
									<input type="checkbox" id="@($"{_uid}-allowLanHttpCheck")" @bind="_cloudSyncModel.AllowHttpOnPrivateNetworks" style="cursor: pointer;" />
									<label for="@($"{_uid}-allowLanHttpCheck")" style="font-size: 13px; color: var(--text-primary); cursor: pointer;">
										@Loc["Settings_SyncAllowLanHttp"]
									</label>
								</div>
								<div role="status" style="background-color: rgba(210, 153, 34, 0.12); border: 1px solid var(--accent-warning); border-radius: 6px; padding: 8px 12px; color: var(--accent-warning); font-size: 12px; display: flex; align-items: flex-start; gap: 8px; max-width: 640px;">
									<span style="flex-shrink: 0; margin-top: 1px;"><AppIcon Name="alert" Size="14" /></span>
									<span>@Loc["Settings_SyncAllowLanHttpWarning"]</span>
								</div>
							</div>
						</div>

						<div style="display: flex; gap: 10px; align-items: center; margin-top: 8px; padding-top: 12px; border-top: 1px solid var(--border-subtle);">
							<button class="btn-secondary" @onclick="TestCloudConnectionAsync" disabled="@_isTestingCloud">
								@if (_isTestingCloud)
								{
									<span class="app-splash-spinner" style="width: 12px; height: 12px; margin: 0;"></span>
									<span>@Loc["Settings_SyncTesting"]</span>
								}
								else
								{
									<AppIcon Name="refresh" Size="13" />
									<span>@Loc["Settings_SyncTestConnection"]</span>
								}
							</button>

							<button class="btn-secondary" @onclick="OpenCloudPortal">
								<AppIcon Name="globe" Size="13" />
								<span>@Loc["Settings_SyncOpenPortal"]</span>
							</button>
						</div>

						@if (!string.IsNullOrEmpty(_cloudTestStatus))
						{
							<div style="padding: 10px 14px; border-radius: 6px; font-size: 12px; @(_cloudTestSuccess ? "background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;" : "background: rgba(248, 113, 113, 0.1); border: 1px solid rgba(248, 113, 113, 0.3); color: #f87171;")">
								@_cloudTestStatus
							</div>
						}

						@if (!string.IsNullOrEmpty(_cloudSuccessMessage))
						{
							<div class="alert-success" style="padding: 10px 14px; border-radius: 6px; font-size: 12px;">
								@_cloudSuccessMessage
							</div>
						}

						@if (!string.IsNullOrEmpty(_cloudErrorMessage))
						{
							<div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 10px 14px; border-radius: 6px; font-size: 12px;">
								@_cloudErrorMessage
							</div>
						}
					</div>

					<div style="display: flex; justify-content: flex-end; margin-top: 20px;">
						<button class="btn-primary" @onclick="SaveCloudSettingsAsync">
							<AppIcon Name="save" Size="14" />
							<span>@Loc["Settings_SyncSave"]</span>
						</button>
					</div>
				</div>
			}
			else if (_activeCategory == "updates")
			{
				<!-- SECTION: APPLICATION UPDATES -->
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">
							<span class="nav-item-icon nav-icon-updates" style="width: 28px; height: 28px;"><AppIcon Name="download" Size="16" /></span>
							<span>@Loc["Settings_UpdatesTitle"]</span>
						</h3>
						<p class="card-section-desc">@Loc["Settings_UpdatesDesc"]</p>
					</div>

					<div class="update-settings-grid">
						<div class="update-info-card">
							<div class="update-info-label">@Loc["Settings_AboutInstalledVersion"]</div>
							<div class="update-info-value">
								<span class="version-badge version-badge-current">v@(Updates.CurrentVersion)</span>
								<span class="version-os-badge">@RuntimeInformation.OSArchitecture</span>
							</div>
						</div>

						<div class="update-info-card">
							<div class="update-info-label">@Loc["Settings_UpdatesStatus"]</div>
							<div class="update-info-value" role="status">
								@if (Updates.IsChecking)
								{
									<span class="update-status-checking">@Loc["Update_Checking"]</span>
								}
								else
								{
									<span class="@UpdateStatusClass(Updates.LastResult)">@Loc.StatusText(Updates.LastResult)</span>
								}
							</div>
							<div class="update-last-checked">
								<span>@Loc["Settings_UpdatesLastChecked"]:</span>
								<span>@(AppSettings.Settings.UpdateLastCheckedAt is { } checkedAt ? checkedAt.ToLocalTime().ToString("g", Loc.Culture()) : Loc["Update_Status_Never"])</span>
							</div>
						</div>
					</div>

					@if (!string.IsNullOrEmpty(_updatesSuccessMessage))
					{
						<div role="status" class="update-callout update-callout-success">
							<AppIcon Name="check" Size="16" />
							<span>@_updatesSuccessMessage</span>
						</div>
					}
					@if (!string.IsNullOrEmpty(_updatesErrorMessage))
					{
						<div role="alert" class="update-callout update-callout-error">
							<AppIcon Name="alert" Size="16" />
							<span>@_updatesErrorMessage</span>
						</div>
					}

					<div class="panel-card update-settings-form">
						<div class="form-group">
							<label class="form-label" for="@($"{_uid}-upd-repo")">@Loc["Settings_UpdatesRepository"]</label>
							<input id="@($"{_uid}-upd-repo")" type="text" class="form-input" spellcheck="false"
								   aria-describedby="@($"{_uid}-upd-repo-help")"
								   @bind="_updateRepository" placeholder="@ReleaseParser.DefaultRepository" />
							<span id="@($"{_uid}-upd-repo-help")" class="update-field-help">@Loc["Settings_UpdatesRepositoryHelp", ReleaseParser.DefaultRepository]</span>
						</div>

						<div class="update-checkbox-row">
							<input type="checkbox" id="@($"{_uid}-upd-startup")" @bind="_updateCheckOnStartup" />
							<label for="@($"{_uid}-upd-startup")">@Loc["Settings_UpdatesCheckOnStartup"]</label>
						</div>
						<div class="update-checkbox-row">
							<input type="checkbox" id="@($"{_uid}-upd-pre")" @bind="_updateIncludePrereleases" />
							<label for="@($"{_uid}-upd-pre")">@Loc["Settings_UpdatesIncludePrereleases"]</label>
						</div>

						<div class="update-actions">
							<button type="button" class="btn-secondary" @onclick="SaveUpdateSettingsAsync">
								<AppIcon Name="save" Size="14" />
								<span>@Loc["Settings_UpdatesSave"]</span>
							</button>
							<button type="button" class="btn-primary" @onclick="CheckForUpdatesNowAsync" disabled="@Updates.IsChecking" aria-busy="@(Updates.IsChecking ? "true" : "false")">
								<AppIcon Name="refresh" Size="14" />
								<span>@(Updates.IsChecking ? Loc["Update_Checking"] : Loc["Settings_UpdatesCheckNow"])</span>
							</button>
							@if (Updates.LastResult is { IsUpdateAvailable: true })
							{
								<button type="button" class="btn-primary" @onclick="Workspace.RequestUpdateDialog">
									<AppIcon Name="download" Size="14" />
									<span>@Loc["Settings_UpdatesViewUpdate"]</span>
								</button>
							}
							<button type="button" class="btn-secondary" @onclick="OpenReleasesPage">
								<AppIcon Name="globe" Size="14" />
								<span>@Loc["Settings_UpdatesOpenReleases"]</span>
							</button>
						</div>
					</div>
				</div>
			}
			else if (_activeCategory == "about")
			{
				<!-- SECTION: ABOUT CAISSADESK -->
				<div class="control-section-card">
					<div class="about-brand-banner">
						<div class="about-brand-lockup">
							<div class="about-brand-emblem-wrap">
								<img src="images/icon.svg" alt="CaissaDesk" class="about-brand-emblem" />
								<div class="about-brand-emblem-glow"></div>
							</div>
							<div class="about-brand-text">
								<div class="about-brand-title">
									<strong class="about-brand-caissa">CAISSA</strong><span class="about-brand-desk">DESK</span>
								</div>
								<div class="about-brand-tagline">@Loc["Settings_AboutTagline"]</div>
							</div>
						</div>
					</div>

					<div class="card-section-header">
						<h3 class="card-section-title">
							<span class="nav-item-icon nav-icon-about" style="width: 28px; height: 28px;"><AppIcon Name="info" Size="16" /></span>
							<span>@Loc["Settings_Nav_About"]</span>
						</h3>
						<p class="card-section-desc">@Loc["Settings_Nav_About_Desc"]</p>
					</div>

					<div class="update-settings-grid">
						<div class="update-info-card">
							<div class="update-info-label">@Loc["Settings_AboutInstalledVersion"]</div>
							<div class="update-info-value">
								<span class="version-badge version-badge-current">v@(Updates.CurrentVersion)</span>
								<span class="version-os-badge">@RuntimeInformation.OSDescription</span>
							</div>
						</div>

						<div class="update-info-card">
							<div class="update-info-label">@Loc["Settings_AboutRuntime"]</div>
							<div class="update-info-value">
								<span style="font-weight: 600; font-size: 13px; color: var(--text-primary);">.NET 10.0 Photino Blazor</span>
								<span class="version-os-badge">@RuntimeInformation.ProcessArchitecture</span>
							</div>
						</div>

						<div class="update-info-card">
							<div class="update-info-label">@Loc["Settings_AboutPairingStandards"]</div>
							<div class="update-info-value">
								<span style="font-weight: 600; font-size: 13px; color: var(--text-primary);">@Loc["Settings_AboutPairingRules"]</span>
								<span class="badge badge-gold" style="font-size: 10px;">TRF16 &amp; TRF06</span>
							</div>
						</div>

						<div class="update-info-card">
							<div class="update-info-label">@Loc["Settings_AboutEcosystem"]</div>
							<div class="update-info-value">
								<span style="font-weight: 600; font-size: 13px; color: var(--text-primary);">CaissaDesk &bull; CaissaResults &bull; Caissalytics</span>
							</div>
						</div>
					</div>
				</div>
			}
		</main>
	</div>
</div>

@code {
	private readonly string _uid = DomIds.Next("settings");
	[Parameter, EditorRequired] public SettingsTab Tab { get; set; } = default!;

	private string _activeCategory = "general";

	private AppSettings _defaultsModel = new();
	private AppSettings _enginesModel = new();
	private AppSettings _cloudSyncModel = new();

	private string? _defaultsSuccessMessage;
	private string? _defaultsErrorMessage;
	private string? _enginesSuccessMessage;
	private string? _enginesErrorMessage;
	private string? _cloudSuccessMessage;
	private bool _isTestingCloud;
	private string? _cloudTestStatus;
	private bool _cloudTestSuccess;

	private bool _isInstalling;
	private string? _installingEngineId;
	private string _installStatus = "";
	private string? _installerErrorMessage;
	private string? _installerNoteMessage;

	private readonly Dictionary<string, PairingResult> _testResults = new(StringComparer.OrdinalIgnoreCase);
	private readonly Dictionary<string, long> _testDurations = new(StringComparer.OrdinalIgnoreCase);

	private string _updateRepository = "";
	private bool _updateCheckOnStartup;
	private bool _updateIncludePrereleases;
	private string? _updatesSuccessMessage;
	private string? _updatesErrorMessage;
	private readonly CancellationTokenSource _updateCheckCts = new();

	protected override void OnInitialized()
	{
		Loc.OnLanguageChanged += StateHasChanged;
		Updates.StateChanged += HandleUpdateStateChanged;
		LoadFromSettings();
	}

	public void Dispose()
	{
		_engineTestCts.Cancel();
		_engineTestCts.Dispose();
		_updateCheckCts.Cancel();
		_updateCheckCts.Dispose();
		Loc.OnLanguageChanged -= StateHasChanged;
		Updates.StateChanged -= HandleUpdateStateChanged;
	}

	// Raised from the background check thread
	private void HandleUpdateStateChanged() => _ = InvokeAsync(StateHasChanged);

	private static string UpdateStatusClass(UpdateCheckResult? result) => result?.Status switch
	{
		UpdateCheckStatus.UpdateAvailable => "update-status-available",
		UpdateCheckStatus.UpToDate => "update-status-uptodate",
		UpdateCheckStatus.RateLimited or UpdateCheckStatus.Failed or UpdateCheckStatus.InvalidRepository => "update-status-error",
		_ => ""
	};

	/// <returns>False (with an error message shown) when the repository is invalid or saving failed.</returns>
	private async Task<bool> SaveUpdateSettingsCoreAsync()
	{
		_updatesSuccessMessage = null;
		_updatesErrorMessage = null;

		string? repo = string.IsNullOrWhiteSpace(_updateRepository)
			? ReleaseParser.DefaultRepository
			: ReleaseParser.NormalizeRepository(_updateRepository);
		if (repo == null)
		{
			_updatesErrorMessage = Loc["Update_Status_InvalidRepository"];
			return false;
		}

		bool repoChanged = !string.Equals(repo, AppSettings.Settings.UpdateRepository, StringComparison.OrdinalIgnoreCase);
		try
		{
			await AppSettings.UpdateSettingsAsync(s =>
			{
				s.UpdateRepository = repo;
				s.CheckForUpdatesOnStartup = _updateCheckOnStartup;
				s.IncludePrereleaseUpdates = _updateIncludePrereleases;
				if (repoChanged)
				{
					// What was learned about another repository's releases no longer applies
					s.UpdateLastCheckedAt = null;
					s.UpdateLatestKnownVersion = null;
				}
			});
		}
		catch (Exception ex)
		{
			_updatesErrorMessage = Loc["Settings_SaveFailed", ex.Message];
			return false;
		}

		_updateRepository = repo;
		return true;
	}

	private async Task SaveUpdateSettingsAsync()
	{
		if (await SaveUpdateSettingsCoreAsync())
		{
			_updatesSuccessMessage = Loc["Settings_UpdatesSaved"];
		}
	}

	private async Task CheckForUpdatesNowAsync()
	{
		if (Updates.IsChecking) return;
		// Check against what the form shows, not what was saved earlier
		if (!await SaveUpdateSettingsCoreAsync()) return;

		try
		{
			var result = await Updates.CheckForUpdatesAsync(_updateCheckCts.Token);
			if (result.IsUpdateAvailable)
			{
				Workspace.RequestUpdateDialog();
			}
		}
		catch (OperationCanceledException)
		{
			// settings tab closed
		}
	}

